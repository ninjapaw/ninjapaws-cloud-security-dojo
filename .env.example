# Copy this file to .env and adjust as needed for local development.
# docker-compose and app.js read these values.

# Port the Node.js/Express app listens on internally
PORT=3000

# Reported NGINX version shown on the dashboard/status endpoints
NGINX_VERSION=1.30.3

# Training vulnerability state: "vulnerable" or "remediated"
VULNERABILITY_STATUS=vulnerable

# Environment label shown in /health
ENVIRONMENT=training

# Toggles the "Microsoft Defender Monitoring Active" badge on the homepage
DEFENDER_ENABLED=false
