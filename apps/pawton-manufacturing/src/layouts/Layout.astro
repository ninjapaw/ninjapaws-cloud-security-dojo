---
const { title = 'Overview' } = Astro.props;
const DEFAULT_THEME = 'dark';
import { getAuthenticatedUsername } from '../lib/adminAuth.mjs';
import { getUser } from '../lib/userAuth.mjs';
import { pageMetadata, SITE_NAME } from '../lib/pageMetadata.mjs';

const adminUsername = getAuthenticatedUsername(Astro.cookies);
const staffUsername = getUser(Astro.cookies);
const metadata = pageMetadata(Astro.url.pathname, title);
Astro.response.headers.set('Cache-Control', 'private, no-store');
---
<!doctype html>
<html lang="en" data-theme={DEFAULT_THEME}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{metadata.title}</title>
  <meta name="description" content={metadata.description} />
  <meta name="robots" content={metadata.robots} />
  <meta name="application-name" content={SITE_NAME} />
  <meta name="author" content="Ninja Paws" />
  <meta name="referrer" content="strict-origin-when-cross-origin" />
  <meta name="theme-color" content="#111827" id="theme-color" />
  {metadata.canonical && <link rel="canonical" href={metadata.canonical} />}
  {metadata.social && <>
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={metadata.title} />
    <meta property="og:description" content={metadata.description} />
    {metadata.canonical && <meta property="og:url" content={metadata.canonical} />}
    <meta name="twitter:card" content={metadata.socialImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={metadata.title} />
    <meta name="twitter:description" content={metadata.description} />
    {metadata.socialImage && <>
      <meta property="og:image" content={metadata.socialImage} />
      <meta property="og:image:type" content="image/png" />
      <meta property="og:image:width" content="1200" />
      <meta property="og:image:height" content="630" />
      <meta property="og:image:alt" content="Pawton Manufacturing paw-and-gear logo. Independent cloud-security training lab." />
      <meta name="twitter:image" content={metadata.socialImage} />
      <meta name="twitter:image:alt" content="Pawton Manufacturing paw-and-gear logo. Independent cloud-security training lab." />
    </>}
  </>}
  <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="16x16 32x32" />
  <link rel="icon" type="image/svg+xml" href="/pawton-mark.svg" sizes="any" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
  <style is:global>
    /* Keep the portal shell visually aligned with the M365 Profiles Fluent palette while leaving
       the data pages free to focus on their SQL-backed content. */
    :root {
      color-scheme: light;
      --blue: #0078d4;
      --link: #005a9e;
      --blue-dark: #106ebe;
      --blue-tint: #eff6fc;
      --text: #201f1e;
      --text-soft: #424242;
      --muted: #605e5c;
      --surface: #fff;
      --surface-alt: #f8f9fb;
      --border: #e1dfdd;
      --success: #107c10;
      --warning: #8a5a00;
      --error: #a4262c;
      --shadow: 0 4px 16px rgb(0 0 0 / 6%);
      font-family: "Segoe UI", "Segoe UI Variable", -apple-system, BlinkMacSystemFont, "Helvetica Neue", Arial, sans-serif;
      background: var(--surface-alt);
      color: var(--text);
    }
    :root[data-theme="dark"] {
      color-scheme: dark;
      --text: #f3f2f1;
      --link: #8ecbff;
      --text-soft: #d0d0d0;
      --muted: #b7b7b7;
      --surface: #1f2937;
      --surface-alt: #111827;
      --border: #374151;
      --blue-tint: #1a2942;
      --shadow: 0 6px 20px rgb(0 0 0 / 35%);
    }
    :root[data-theme="dark"] .banner, :root[data-theme="dark"] .danger { background: #321b22; border-color: #71343f; color: #ffb4bd; }
    :root[data-theme="dark"] .warn { background: #332914; border-color: #735b20; color: #f4d27d; }
    :root[data-theme="dark"] .ok { background: #173321; border-color: #2d7043; color: #8cdda1; }
    * { box-sizing: border-box; }
    body { margin: 0; min-height: 100vh; background: var(--surface-alt); line-height: 1.55; }
    a { color: var(--link); text-underline-offset: 3px; }
    :focus-visible { outline: 2px solid var(--link); outline-offset: 3px; }
    .header-inner { flex-wrap: wrap; padding-block: 10px; }
    nav { align-items: center; }
    main { width: 100%; min-width: 0; }
    .card, .grid > *, form { min-width: 0; }
    .card h3 { margin-top: 0; font-size: 18px; }
    .card .value { overflow-wrap: anywhere; }
    .badge { color: var(--link); font-size: 14px; font-weight: 600; }
    .status-hero { display: flex; align-items: center; justify-content: space-between; gap: 24px; border: 1px solid var(--border); background: var(--surface); }
    .status-hero h2 { margin: 0 0 4px; font-size: 28px; }
    .status-hero p { margin: 0; }
    .status-pill { display: inline-flex; align-items: center; white-space: nowrap; padding: 8px 12px; border-radius: 999px; font-size: 13px; font-weight: 700; }
    .status-pill--ok { color: #9be5ad; background: #174326; }
    .status-pill--warn { color: #f5d483; background: #49391a; }
    .muted { color: var(--muted); }
    .confirmation { flex-direction: row; align-items: center; margin: 10px 0; }
    .row-actions { display: flex; flex-wrap: wrap; gap: 10px; align-items: end; }
    select { color: var(--text); background: var(--surface); border: 1px solid var(--border); padding: 8px; border-radius: 4px; max-width: 100%; }
    button:disabled { opacity: .55; cursor: not-allowed; }
    pre { max-width: 100%; overflow: auto; padding: 16px; background: var(--surface); border: 1px solid var(--border); border-radius: 4px; font-size: 13px; }
    pre code { border: 0; padding: 0; background: none; }
    p, td, code, .probe-result { overflow-wrap: anywhere; }
    body > header { position: sticky; top: 0; z-index: 10; background: var(--surface); border-bottom: 1px solid var(--border); box-shadow: 0 1px 2px rgb(0 0 0 / 4%); }
    .header-inner { max-width: 1180px; min-height: 60px; margin: 0 auto; padding: 0 20px; display: flex; align-items: center; gap: 24px; }
    .brand { display: inline-flex; align-items: center; gap: 10px; color: var(--text); text-decoration: none; font-size: 17px; font-weight: 700; white-space: nowrap; }
    .brand-mark { display: block; width: 32px; height: 32px; flex: 0 0 32px; }
    nav { display: flex; gap: 4px; margin-left: auto; flex-wrap: wrap; }
    nav a, .theme-toggle { color: var(--text-soft); text-decoration: none; font-size: 14px; font-weight: 500; border: 0; background: transparent; border-radius: 6px; padding: 8px 12px; cursor: pointer; }
    nav a:hover, nav a.active, .theme-toggle:hover { color: var(--link); background: var(--blue-tint); text-decoration: none; }
    .user-chip { max-width: 180px; overflow: hidden; color: var(--muted); font-size: 12px; text-overflow: ellipsis; white-space: nowrap; padding: 8px 4px; }
    .logout-form { margin: 0; }
    .nav-action { color: var(--link); background: transparent; padding: 8px 12px; }
    .nav-action:hover { background: var(--blue-tint); }
    .theme-toggle { border: 1px solid var(--border); font-size: 16px; padding: 5px 9px; }
    main { max-width: 1180px; margin: 0 auto; padding: 34px 20px 56px; }
    .page-header { margin-bottom: 28px; max-width: 820px; }
    .eyebrow { margin: 0 0 8px; color: var(--link); font-size: 12px; font-weight: 700; letter-spacing: 0; text-transform: uppercase; }
    .page-header h1 { margin: 0 0 10px; }
    .page-header p { margin: 0; font-size: 16px; }
    .section { margin-top: 28px; padding: 22px 0; border-top: 1px solid var(--border); }
    .section-header { display: flex; align-items: baseline; justify-content: space-between; flex-wrap: wrap; gap: 16px; margin-bottom: 16px; }
    .section-header h2 { margin: 0; }
    .section-header p { margin: 0; font-size: 13px; }
    h1, h2, h3 { line-height: 1.25; font-weight: 600; color: var(--text); } h1 { font-size: 2.25rem; } h2 { font-size: 1.75rem; } h3 { font-size: 1.25rem; }
    p { color: var(--text-soft); line-height: 1.55; }
    .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 14px; margin: 18px 0; }
    .card { border: 1px solid var(--border); border-radius: 8px; padding: 18px; background: var(--surface); box-shadow: var(--shadow); }
    .card .label { color: var(--muted); font-size: 12px; text-transform: uppercase; letter-spacing: 0; }
    .card .value { font-size: 22px; margin-top: 6px; color: var(--link); font-weight: 600; }
    .table-shell { overflow-x: auto; border: 1px solid var(--border); border-radius: 6px; }
    table { border-collapse: collapse; width: 100%; min-width: 640px; background: var(--surface); }
    th, td { text-align: left; padding: 10px 12px; border-bottom: 1px solid var(--border); font-size: 13px; color: var(--text-soft); vertical-align: top; }
    th { color: var(--muted); text-transform: uppercase; font-size: 12px; letter-spacing: 0; }
    .banner, .warn, .danger, .ok { padding: 12px 14px; border-radius: 6px; font-size: 13px; margin-bottom: 18px; border: 1px solid; }
    .banner, .danger { background: #fdf0f0; border-color: #f1c5c5; color: var(--error); } .warn { background: #fff8e7; border-color: #f1d28a; color: var(--warning); } .ok { background: #f0faf0; border-color: #b7dfb7; color: var(--success); }
    footer { padding: 18px 20px; color: var(--muted); font-size: 11px; border-top: 1px solid var(--border); background: var(--surface); }
    a.pill { display: inline-block; color: #fff; background: var(--blue); padding: 7px 12px; border-radius: 6px; font-size: 13px; font-weight: 600; text-decoration: none; } a.pill:hover, button:hover { background: var(--blue-dark); }
    form.stack { display: flex; flex-direction: column; gap: 14px; max-width: 360px; } label { font-size: 13px; color: var(--text-soft); display: flex; flex-direction: column; gap: 6px; }
    input[type="text"], input[type="password"] { background: var(--surface); border: 1px solid var(--border); border-radius: 4px; padding: 9px 10px; color: var(--text); font: inherit; font-size: 14px; } input:focus { outline: 2px solid var(--blue); outline-offset: 1px; }
    button { background: var(--blue); color: #fff; border: none; border-radius: 6px; padding: 9px 16px; font-weight: 600; font-size: 13px; cursor: pointer; } button.secondary { background: transparent; color: var(--blue); border: 1px solid var(--blue); } button.destructive { background: var(--error); color: #fff; }
    .actions { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 12px; } code { background: var(--blue-tint); border: 1px solid var(--border); border-radius: 4px; padding: 1px 6px; font-size: 12px; } details summary { cursor: pointer; color: var(--blue); } details pre { background: var(--surface-alt); border: 1px solid var(--border); border-radius: 4px; padding: 10px; font-size: 11px; margin-top: 8px; overflow: auto; }
    dl { display: grid; grid-template-columns: 150px 1fr; gap: 8px 16px; color: var(--text-soft); font-size: 13px; } dt { color: var(--muted); font-weight: 600; } dd { margin: 0; overflow-wrap: anywhere; }
    @media (max-width: 720px) { .header-inner { gap: 8px; padding-block: 10px; } .brand { font-size: 15px; } nav { gap: 0; order: 3; flex-basis: 100%; } .theme-toggle { margin-left: auto; } nav a, .nav-action { padding: 7px 6px; font-size: 12px; } .user-chip { max-width: 120px; padding: 7px 2px; } main { padding-top: 24px; } h1 { font-size: 1.8rem; } .section { padding: 16px 0; } .section-header { display: block; } .status-hero { display: block; } .status-pill { margin-top: 16px; } .section-header p { margin-top: 5px; } dl { grid-template-columns: 1fr; gap: 2px; } dd { margin-bottom: 8px; } }
  </style>
</head>
<body>
  <header>
    <div class="header-inner">
    <a class="brand" href="/" aria-label="Pawton Manufacturing home"><img class="brand-mark" src="/pawton-mark.svg" width="32" height="32" alt="" /><span>Pawton Manufacturing</span></a>
    <nav>
      <a href="/">Overview</a>
      <a href="/inventory">Inventory</a>
      <a href="/sales">Sales</a>
      <a href="/orders">Manage orders</a>
      <a href="/production">Production</a>
      <a href="/status">Status</a>
      {adminUsername ? (
        <>
          <a href="/users">SQL logins</a>
          <a href="/admin">Security lab</a>
          <a href="/admin/schema">Schema</a>
          <a href="/admin/auditing">Auditing</a>
          <span class="user-chip" title={`Signed in as ${adminUsername}`}>{adminUsername}</span>
          <form class="logout-form" method="post" action="/api/admin/logout">
            <button class="nav-action" type="submit">Logout</button>
          </form>
        </>
      ) : (
        <>
          {staffUsername ? <>
            <span class="user-chip" title={`Manager: ${staffUsername}`}>{staffUsername}</span>
            <form class="logout-form" method="post" action="/api/user/logout"><button class="nav-action" type="submit">Sign out</button></form>
          </> : <a href="/login">Log in as manager</a>}
          <a href="/admin/login">Admin</a>
        </>
      )}
    </nav>
    <button class="theme-toggle" id="theme-toggle" type="button" aria-label="Toggle color theme" title="Toggle color theme">◐</button>
    </div>
  </header>
  <main>
    <slot />
  </main>
  <footer>
    Ninja Paws Cloud Security Dojo &middot; Isolated training environment &middot; Futon Manufacturing sample data from microsoft/sql-server-samples. Verify protection status in the Security lab and Azure.
  </footer>
  <script is:inline define:vars={{ defaultTheme: DEFAULT_THEME }}>
    // Persist the operator's theme choice without adding a server-side preference or account state.
    const themeKey = 'pawton-theme';
    try {
      const savedTheme = localStorage.getItem(themeKey);
      document.documentElement.dataset.theme = ['light', 'dark'].includes(savedTheme) ? savedTheme : defaultTheme;
    } catch { document.documentElement.dataset.theme = defaultTheme; }
    const updateThemeColor = () => document.getElementById('theme-color')?.setAttribute('content', document.documentElement.dataset.theme === 'dark' ? '#111827' : '#f8f9fb');
    updateThemeColor();
    document.getElementById('theme-toggle')?.addEventListener('click', () => {
      const theme = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
      document.documentElement.dataset.theme = theme;
      updateThemeColor();
      try { localStorage.setItem(themeKey, theme); } catch {}
    });
    const path = window.location.pathname.replace(/\/$/, '') || '/';
    document.querySelectorAll('nav a').forEach((link) => {
      if (link.getAttribute('href') === path) {
        link.classList.add('active');
        link.setAttribute('aria-current', 'page');
      }
    });
  </script>
</body>
</html>
