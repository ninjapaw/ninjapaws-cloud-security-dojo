---
const { title = 'Overview' } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title} — Pawton Manufacturing</title>
  <style>
    :root { color-scheme: dark; font-family: Inter, ui-sans-serif, system-ui, sans-serif; background: #0a1220; color: #d9e7f5; }
    body { margin: 0; }
    header { padding: 20px 32px; border-bottom: 1px solid #28415c; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 10px; }
    header h1 { color: #f2a24a; font-size: 20px; margin: 0; }
    nav a { color: #7cc4f2; margin-left: 18px; text-decoration: none; font-size: 14px; }
    nav a:hover { text-decoration: underline; }
    main { padding: 24px 32px 48px; max-width: 1100px; margin: 0 auto; }
    .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 14px; margin: 18px 0; }
    .card { border: 1px solid #28415c; border-radius: 10px; padding: 16px; background: #0d1a2b; }
    .card .label { color: #8fa6bc; font-size: 11px; text-transform: uppercase; letter-spacing: .08em; }
    .card .value { font-size: 26px; margin-top: 6px; color: #7be2a5; }
    table { border-collapse: collapse; width: 100%; margin-top: 10px; }
    th, td { text-align: left; padding: 8px 10px; border-bottom: 1px solid #28415c; font-size: 13px; }
    th { color: #8fa6bc; text-transform: uppercase; font-size: 11px; }
    .banner { padding: 10px 14px; border-radius: 8px; background: #3a1414; border: 1px solid #6d1f1f; color: #f2a7a7; font-size: 12px; margin-bottom: 16px; }
    .warn { padding: 10px 14px; border-radius: 8px; background: #3a2f14; border: 1px solid #6d5a1f; color: #f2cf7c; font-size: 12px; margin-bottom: 16px; }
    .danger { padding: 10px 14px; border-radius: 8px; background: #3a1414; border: 1px solid #6d1f1f; color: #f2a7a7; font-size: 12px; margin-bottom: 16px; }
    .ok { padding: 10px 14px; border-radius: 8px; background: #14301f; border: 1px solid #1f6d3f; color: #7ce2a5; font-size: 12px; margin-bottom: 16px; }
    footer { padding: 16px 32px; color: #58718b; font-size: 11px; border-top: 1px solid #28415c; }
    a.pill { color: #102f4d; background: #f2a24a; padding: 4px 10px; border-radius: 999px; font-size: 12px; font-weight: 700; text-decoration: none; }
    form.stack { display: flex; flex-direction: column; gap: 12px; max-width: 360px; }
    label { font-size: 13px; color: #8fa6bc; display: flex; flex-direction: column; gap: 4px; }
    input[type="text"], input[type="password"] { background: #0a1220; border: 1px solid #28415c; border-radius: 6px; padding: 8px 10px; color: #d9e7f5; font-size: 14px; }
    button { background: #f2a24a; color: #102f4d; border: none; border-radius: 8px; padding: 9px 16px; font-weight: 700; font-size: 13px; cursor: pointer; }
    button.secondary { background: transparent; color: #f2a24a; border: 1px solid #f2a24a; }
    button.destructive { background: #d94f4f; color: #fff; }
    .actions { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 10px; }
    code { background: #0a1220; border: 1px solid #28415c; border-radius: 4px; padding: 1px 6px; font-size: 12px; }
    details summary { cursor: pointer; color: #7cc4f2; }
    details pre { background: #0a1220; border: 1px solid #28415c; border-radius: 6px; padding: 8px; font-size: 11px; margin-top: 6px; }
  </style>
</head>
<body>
  <header>
    <h1>🐾 Pawton Manufacturing</h1>
    <nav>
      <a href="/">Overview</a>
      <a href="/inventory">Inventory</a>
      <a href="/sales">Sales</a>
      <a href="/production">Production</a>
      <a href="/admin">Admin</a>
    </nav>
  </header>
  <main>
    <slot />
  </main>
  <footer>
    Ninja Paws Cloud Security Dojo &middot; Scenario 2 demo data (Futon Manufacturing sample from microsoft/sql-server-samples) &middot; Not a real business. Protected by Microsoft Defender for App Service, Defender for SQL, and Defender for Servers.
  </footer>
</body>
</html>
