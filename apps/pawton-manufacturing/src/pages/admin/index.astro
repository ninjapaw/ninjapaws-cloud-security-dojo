---
import Layout from '../../layouts/Layout.astro';
import { isAuthenticated, ROTATED_SECRET_COOKIE_NAME } from '../../lib/adminAuth.mjs';
import { isAdminDbConfigured, getSaStatus } from '../../lib/adminDb.mjs';
import { isAdminSecretsConfigured } from '../../lib/adminSecrets.mjs';
import { isAuditLogConfigured, getRecentSaAuditEvents } from '../../lib/auditLog.mjs';

if (!isAuthenticated(Astro.cookies)) {
  return Astro.redirect('/admin/login');
}

const msg = Astro.url.searchParams.get('msg');
const error = Astro.url.searchParams.get('error');

// Shown exactly once: read the just-rotated password (if present) and delete the cookie
// immediately, so refreshing this page or a later visit never reveals it again.
const rotatedPassword = Astro.cookies.get(ROTATED_SECRET_COOKIE_NAME)?.value ?? null;
if (rotatedPassword) {
  Astro.cookies.delete(ROTATED_SECRET_COOKIE_NAME, { path: '/' });
}

let saStatus = null;
let saError = null;
if (isAdminDbConfigured()) {
  try {
    saStatus = await getSaStatus();
  } catch (err) {
    saError = err.message;
  }
} else {
  saError = 'SQL_ADMIN_LOGIN / SQL_ADMIN_LOGIN_PASSWORD are not configured on this Web App yet.';
}

const messages = {
  sa_enabled: { text: 'sa login enabled.', kind: 'warn' },
  sa_disabled: { text: 'sa login disabled.', kind: 'ok' },
  sa_rotated: { text: 'Built-in administrator password rotated and stored in Key Vault. Copy it now -- it will not be shown again.', kind: 'warn' },
  sa_renamed: { text: 'Built-in administrator login renamed and synchronized to Key Vault.', kind: 'warn' },
};
const statusMessage = msg ? messages[msg] : null;

// Independent confirmation, separate from the SQL connection the actions above used: did the
// action actually reach the Windows Application log and get forwarded to Log Analytics? Ingestion
// typically takes a few minutes, so a just-performed action may not appear yet on this page load.
let auditEvents = [];
let auditError = null;
let auditConfigured = isAuditLogConfigured();
if (auditConfigured) {
  try {
    const auditResult = await getRecentSaAuditEvents(30);
    auditEvents = auditResult.events;
  } catch (err) {
    auditError = err.message;
  }
}
---
<Layout title="Admin">
  <div class="banner">
    <strong>High-privilege area.</strong> The actions below run as <code>dojo_admin_portal_svc</code>,
    a SQL login granted <code>CONTROL SERVER</code> so it can manage the SQL Server built-in administrator login --
    SQL Server does not accept any narrower permission for that operation. Every action here is
    recorded by <code>FutonManufacturingServerAuditSpec</code> (Server Audit) and forwarded to the
    <code>log-np-sentinel-centralus</code> Log Analytics workspace. See the repository README for
    why this is a deliberate anti-pattern this scenario demonstrates, not a production example.
  </div>

  {statusMessage && <div class={statusMessage.kind}>{statusMessage.text}</div>}
  {error && <div class="danger">Action failed: {error}</div>}
  {rotatedPassword && (
    <div class="danger">
      <strong>New built-in administrator password (shown once):</strong> <code>{rotatedPassword}</code>
    </div>
  )}

  <h2>Built-in administrator login status</h2>
  {saError && <div class="warn">Could not read the built-in administrator login status: {saError}</div>}
  {saStatus && (
    <div class="grid">
      <div class="card">
        <div class="label">Current username</div>
        <div class="value">{saStatus.username}</div>
      </div>
      <div class="card">
        <div class="label">Status</div>
        <div class="value">{saStatus.enabled ? 'Enabled' : 'Disabled'}</div>
      </div>
      <div class="card">
        <div class="label">Password last set</div>
        <div class="value" style="font-size: 15px;">{saStatus.passwordLastSetTime ?? 'unknown'}</div>
      </div>
    </div>
  )}

  <div class="actions">
    {saStatus && saStatus.enabled && (
      <form method="post" action="/api/admin/sa/disable">
        <button type="submit" class="secondary">Disable {saStatus.username}</button>
      </form>
    )}
    {saStatus && !saStatus.enabled && (
      <form method="post" action="/api/admin/sa/enable">
        <button type="submit">Enable {saStatus.username}</button>
      </form>
    )}
    <form method="post" action="/api/admin/sa/rotate">
      <button type="submit" class="destructive">Rotate password</button>
    </form>
    <form method="post" action="/api/admin/sa/rename" class="stack">
      <label for="newUsername">New username</label>
      <input id="newUsername" name="newUsername" required pattern="[A-Za-z_][A-Za-z0-9_]{0,127}" maxlength="128" />
      <button type="submit" class="destructive">Rename built-in administrator</button>
    </form>
    <form method="post" action="/api/admin/logout">
      <button type="submit" class="secondary">Sign out</button>
    </form>
  </div>

  {!isAdminSecretsConfigured() && (
    <div class="warn">KEY_VAULT_URI is not configured. Password rotations and username changes cannot synchronize their Key Vault secrets.</div>
  )}

  <h2>Windows Event confirmation</h2>
  <p>
    Independent confirmation that admin portal actions actually reached the Windows Application
    log and were forwarded to <code>log-np-sentinel-centralus</code>, queried live with this Web
    App's own read-only managed identity (no stored credential). Ingestion can take a few minutes,
    so a just-performed action may not appear on this page load yet -- refresh to check again.
  </p>
  {!auditConfigured && (
    <div class="warn">LOG_ANALYTICS_WORKSPACE_ID is not configured on this Web App yet.</div>
  )}
  {auditError && <div class="warn">Could not query Log Analytics: {auditError}</div>}
  {auditConfigured && !auditError && auditEvents.length === 0 && (
    <div class="warn">No matching Windows events in the last 30 minutes yet.</div>
  )}
  {/* Keep a separate Event Viewer-style view so operators can inspect the forwarded Windows record itself. */}
  {auditEvents.length > 0 && (
    <table>
      <thead>
        <tr><th>Time</th><th>Event ID</th><th>Action ID</th><th>Principal</th><th>Client</th><th>Result</th><th>Summary</th></tr>
      </thead>
      <tbody>
        {auditEvents.map((event) => (
          <tr>
            <td>{new Date(event.TimeGenerated).toISOString()}</td>
            <td>{event.EventID}</td>
            <td>{event.ActionId ?? 'n/a'}</td>
            <td>{event.LoginName ?? 'n/a'}</td>
            <td>{event.ClientIp ?? 'n/a'}</td>
            <td>{event.Success === true ? 'success' : event.Success === false ? 'failed' : 'unknown'}</td>
            <td>
              <details>
                <summary>{event.Summary ?? String(event.RenderedDescription ?? '').slice(0, 140)}</summary>
                <pre style="white-space: pre-wrap; word-break: break-word;">{event.RenderedDescription}</pre>
              </details>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  )}

  {auditEvents.length > 0 && (
    <section>
      <h3>Local Event Viewer record</h3>
      <p>
        These fields mirror the Windows Event Viewer record collected from the SQL VM's Application
        log before forwarding. The raw description is preserved for independent review.
      </p>
      {auditEvents.map((event) => (
        <details>
          <summary>
            {event.Computer ?? 'Unknown computer'} -- Event ID {event.EventID} -- {new Date(event.TimeGenerated).toISOString()}
          </summary>
          <dl>
            <dt>Log</dt><dd>{event.EventLog ?? 'Application'}</dd>
            <dt>Source</dt><dd>{event.Source ?? 'MSSQLSERVER'}</dd>
            <dt>Level</dt><dd>{event.EventLevelName ?? 'n/a'}</dd>
            <dt>Computer</dt><dd>{event.Computer ?? 'n/a'}</dd>
            <dt>Event ID</dt><dd>{event.EventID}</dd>
            <dt>Time generated</dt><dd>{new Date(event.TimeGenerated).toISOString()}</dd>
          </dl>
          <pre style="white-space: pre-wrap; word-break: break-word;">{event.RenderedDescription}</pre>
        </details>
      ))}
    </section>
  )}
</Layout>
