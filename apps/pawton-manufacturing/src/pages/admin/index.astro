---
import Layout from '../../layouts/Layout.astro';
import RecordPager from '../../components/RecordPager.astro';
import { isAuthenticated } from '../../lib/adminAuth.mjs';
import { getDefenderStatus } from '../../lib/defenderStatus.mjs';
import { probes, alertReferenceDocs, isSqlDemoActionsEnabled } from '../../lib/securityLab.mjs';
import { isAuditLogConfigured, getRecentSaAuditEvents, auditOperationFilters, normalizeAuditFilter } from '../../lib/auditLog.mjs';
import { sqlAttackRunner, attackScenarios } from '../../lib/sqlAttackLab.mjs';
import { getSqlShellStatus } from '../../lib/adminDb.mjs';
import { formatTimestamp, getPortalTimeZone } from '../../lib/timeZone.mjs';

if (!isAuthenticated(Astro.cookies)) {
  return Astro.redirect('/admin/login');
}

Astro.response.headers.set('Cache-Control', 'no-store');
const defender = await getDefenderStatus();
const portalTimeZone = getPortalTimeZone();
const demosEnabled = isSqlDemoActionsEnabled();
const simulationAvailability: { ids: string[]; reason: string | null } = await sqlAttackRunner.availability();
const sqlShellDeploymentDefault = process.env.SQL_SHELL_ATTACK_TESTS_ENABLED !== 'false';
let sqlShellEnabled: boolean | null = null;
try { sqlShellEnabled = (await getSqlShellStatus()).enabled; } catch { }
const sqlShellMessages: Record<string, string> = {
  enabled: 'SQL shell access enabled and verified.',
  disabled: 'SQL shell access disabled and verified.',
  error: 'SQL shell change could not be verified. Check the live state and SQL administrator permissions.',
};
const sqlShellMessage = sqlShellMessages[Astro.url.searchParams.get('shell') ?? ''];

// Independent confirmation, separate from the SQL connection the actions above used: did the
// action actually reach the Windows Application log and get forwarded to Log Analytics? Ingestion
// typically takes a few minutes, so a just-performed action may not appear yet on this page load.
let auditEvents: Array<{ TimeGenerated: string; EventID: number; ActionId: string | null; Operation: string; LoginName: string | null; TargetLogin: string | null; ClientIp: string | null; Success: boolean | null; Summary: string; RenderedDescription: string; Computer: string; EventLog: string; Source: string; EventLevelName: string }> = [];
let auditError = null;
let auditTotal = 0;
let auditStart = 0;
let auditWindowEnd = '';
const auditOperation = normalizeAuditFilter(Astro.url.searchParams.get('operation'));
let auditConfigured = isAuditLogConfigured();
if (auditConfigured) {
  try {
    const auditResult = await getRecentSaAuditEvents(30, 25, {
      record: Astro.url.searchParams.get('record') ?? '1',
      until: Astro.url.searchParams.get('until') ?? '',
      operation: auditOperation,
    });
    auditEvents = auditResult.events;
    auditTotal = auditResult.total;
    auditStart = auditResult.start;
    auditWindowEnd = auditResult.windowEnd;
  } catch (err) {
    auditError = err instanceof Error ? err.message : 'Audit query unavailable.';
  }
}
---
<Layout title="Security lab">
  <header class="page-header"><p class="eyebrow">Scenario 2 / SQL Server protection</p><h1>Security lab</h1>
    <p>Inspect protection, exercise SQL auditing, and validate security response in an isolated training environment. Manage sign-in identities in <a href="/users">Users</a> and inspect tables and roles in <a href="/admin/schema">Schema</a>.</p>
  </header>
  <div class="banner"><strong>Deliberately privileged demo.</strong> This portal holds a SQL administration credential. Do not expose it to untrusted users or treat it as a production administration pattern.</div>
  <section class="section"><div class="section-header"><h2>Live protection observations</h2><a href="/admin">Refresh status</a></div>
    <p>Checked <time datetime={defender.checkedAt}>{formatTimestamp(defender.checkedAt, portalTimeZone)}</time>. These status checks use read-only Azure queries through the app identity.</p>
    <div class="grid">{defender.observations.map((observation) => <article class="card"><h3>{observation.label}</h3><span class="badge">{observation.state}</span><p>{observation.detail}</p></article>)}</div>
    <p>Unavailable means unverified, not disabled. Subscription pricing and extension provisioning alone do not prove end-to-end detection health.</p>
  </section>
  <section class="section" id="sql-shell-settings"><h2>Admin settings</h2>
    <p>Display timezone: <strong>{portalTimeZone}</strong></p>
    <h3>SQL shell access (xp_cmdshell)</h3>
    <p>Live state: <strong>{sqlShellEnabled === null ? 'Unavailable' : sqlShellEnabled ? 'Enabled' : 'Disabled'}</strong>. Deployment default: <strong>{sqlShellDeploymentDefault ? 'Enabled' : 'Disabled'}</strong>.</p>
    <div class="warn">Lab-only setting. SQL shell access permits operating-system commands with the SQL execution identity's privileges. Disabling it blocks new shell calls but does not stop commands already running or disable Defender.</div>
    {sqlShellMessage && <p role="status">{sqlShellMessage}</p>}
    {sqlShellEnabled === null && <p>SQL status could not be read. Setting changes are unavailable until the administrator connection is restored.</p>}
    <form class="stack" method="post" action="/api/admin/sql-shell">
      <label class="confirmation"><input type="checkbox" name="confirm" value="yes" required disabled={sqlShellEnabled === null} />I authorize this server-wide lab setting change</label>
      <div class="actions"><button type="submit" name="enabled" value={sqlShellEnabled === false ? 'true' : 'false'} disabled={sqlShellEnabled === null}>{sqlShellEnabled === null ? 'SQL shell unavailable' : sqlShellEnabled ? 'Disable SQL shell access' : 'Enable SQL shell access'}</button></div>
    </form>
    <p>Admin changes persist in SQL Server. A subsequent bootstrap run reapplies the deployment variable <code>enableSqlShellAttackTests</code>.</p>
  </section>
  <section class="section"><h2>Local SQL audit samples</h2><p>Run fixed, safe sample scripts against this configured instance. They generate audit evidence, not guaranteed Defender alerts. Each run has an evidence marker and a 60-second cooldown.</p>
    {!demosEnabled && <div class="warn">Local exercises are disabled. Set ENABLE_SQL_DEMO_ACTIONS=false to turn them off explicitly.</div>}
    <div class="grid">{probes.map((probe) => <article class="card"><h3>{probe.name}</h3><p>{probe.description}</p><form class="probe-form" method="post" action="/api/admin/probe">
      <input type="hidden" name="probe" value={probe.id} /><label class="confirmation"><input type="checkbox" name="confirm" value="yes" required disabled={!demosEnabled} />I authorize this demo</label>
      <button type="submit" disabled={!demosEnabled}>Run sample</button><p class="probe-result" role="status" aria-live="polite"></p>
    </form></article>)}</div>
    <details><summary>Sample SQL</summary><p>The portal generates a unique run ID in place of <code>&lt;run-id&gt;</code> and enforces the same fixed statements shown here.</p>{probes.map((probe) => <div><h3>{probe.name}</h3><pre><code>{probe.script}</code></pre></div>)}</details>
  </section>
  <section class="section"><div class="section-header"><h2>Defender for SQL attack tests</h2><a href={alertReferenceDocs} target="_blank" rel="noopener noreferrer">SQL alert reference</a></div>
    <p>Direct, bounded activity against the configured lab SQL Server. Results distinguish execution from SQL blocking; Defender detection is not guaranteed. Anomaly detections depend on learned behavior. External-source tests only print a URL and do not reproduce a download.</p>
    {simulationAvailability.reason && <div class="warn">{simulationAvailability.reason}</div>}
    <div class="grid">{attackScenarios.map((scenario) => <article class="card"><h3>{scenario.name}</h3><p>{scenario.description}</p><p class="muted">{scenario.evidence}</p>
    <form class="defender-simulation-form" method="post" action="/api/admin/defender-simulation">
      <input type="hidden" name="simulation" value={scenario.id} /><label class="confirmation"><input type="checkbox" name="confirm" value="yes" required disabled={!simulationAvailability.ids.includes(scenario.id)} />I authorize this lab test</label>
      <button type="submit" disabled={!simulationAvailability.ids.includes(scenario.id)}>Run attack test</button><p class="simulation-sample-result" role="status" aria-live="polite"></p>
      {!simulationAvailability.ids.includes(scenario.id) && <p class="muted">SQL connection unavailable or lab tests disabled.</p>}
    </form>
    <details><summary>Audit-only sample</summary><form class="simulation-sample-form" method="post" action="/api/admin/simulation-sample">
      <input type="hidden" name="simulation" value={scenario.id} /><label class="confirmation"><input type="checkbox" name="confirm" value="yes" required disabled={!demosEnabled} />I authorize this sample</label>
      <button type="submit" disabled={!demosEnabled}>Run audit sample</button><p class="simulation-sample-result" role="status" aria-live="polite"></p>
    </form></details></article>)}</div>
    <p>Audit-only samples produce SQL Audit evidence, not Defender alerts. A matching Sentinel training incident is separate from a Defender for SQL alert. <a href={alertReferenceDocs} target="_blank" rel="noopener noreferrer">Documented SQL alerts</a>.</p>
  </section>
  <section class="section"><h2>Compare protection states</h2><p>Defender for SQL detects suspicious activity and assesses vulnerabilities. It is not a general-purpose query-blocking firewall. SQL permissions, password policy, encryption, and SQL Audit remain separate controls.</p>
    <p>Plan changes can affect other SQL machines and billing. Disable or re-enable protection only through Azure's authenticated environment settings after confirming scope, recording the baseline, and arranging restoration. This portal deliberately has no subscription-wide off switch.</p>
    <p>For a single SQL VM, Microsoft's resource-level procedure removes the Defender for SQL extension. Automatic provisioning or policy may restore it. Review the <a href="https://learn.microsoft.com/azure/defender-for-cloud/disable-sql-on-machines" target="_blank" rel="noopener noreferrer">disable procedure</a> and <a href="https://learn.microsoft.com/azure/defender-for-cloud/defender-for-sql-usage" target="_blank" rel="noopener noreferrer">enable/restore procedure</a> before an approved comparison. SQL Audit continues independently.</p>
    <ol><li>Record current plan and sensor health on the isolated test machine.</li><li>Run the supported simulation while protected and retain its alert evidence.</li><li>Use Azure to make the approved, scoped comparison; keep SQL Audit enabled.</li><li>Restore protection, recheck health, and repeat the supported simulation.</li></ol>
    <a href="https://portal.azure.com/#view/Microsoft_Azure_Security/SecurityMenuBlade/~/environmentSettings" target="_blank" rel="noopener noreferrer">Review Defender environment settings</a>
  </section>

  <h2 id="windows-events">Windows Event confirmation</h2>
  <form class="event-filter" method="get" action="/admin#windows-events">
    {auditWindowEnd && <input type="hidden" name="until" value={auditWindowEnd} />}
    <div class="event-filter-field">
      <label for="event-operation-filter">Filter</label>
      <select id="event-operation-filter" name="operation">
        {auditOperationFilters.map(filter => <option value={filter.value} selected={auditOperation === filter.value}>{filter.label}</option>)}
      </select>
    </div>
    <button type="submit">Apply filter</button>
  </form>
  {!defender.target.vmId && <div class="warn">No VM scope is configured. These are workspace-wide SQL events and may belong to other machines.</div>}
  <p><a class="pill" href="/admin/auditing">View SQL auditing configuration</a></p>
  <p>
    Independent confirmation that admin portal actions actually reached the Windows Application
    log and were forwarded to the configured Log Analytics workspace, queried live with this Web
    App's own read-only managed identity (no stored credential). Login enablement and disablement
    are identified from the SQL Audit action and statement. Ingestion can take a few minutes,
    so a just-performed action may not appear on this page load yet -- refresh to check again.
  </p>
  {!auditConfigured && (
    <div class="warn">LOG_ANALYTICS_WORKSPACE_ID is not configured on this Web App yet.</div>
  )}
  {auditError && <div class="warn">Could not query Log Analytics: {auditError}</div>}
  {auditConfigured && !auditError && auditEvents.length === 0 && (
    <div class="warn">No Windows events match this filter in the 30-minute window.</div>
  )}
  {auditWindowEnd && <form class="event-refresh" method="get" action="/admin#windows-events">
    <p>30-minute window ending {formatTimestamp(auditWindowEnd, portalTimeZone)}.</p>
    <input type="hidden" name="operation" value={auditOperation} />
    <button type="submit">Refresh events</button>
  </form>}
  {/* Keep a separate Event Viewer-style view so operators can inspect the forwarded Windows record itself. */}
  {auditEvents.length > 0 && (
    <div class="table-shell" tabindex="0" role="region" aria-label="Forwarded audit events"><table id="audit-event-table">
      <thead>
        <tr><th>Time ({portalTimeZone})</th><th>Event ID</th><th>Action ID</th><th>Operation</th><th>Actor</th><th>Target login</th><th>Client</th><th>Result</th><th>Summary</th></tr>
      </thead>
      <tbody>
        {auditEvents.map((event) => (
          <tr>
            <td><time datetime={event.TimeGenerated}>{formatTimestamp(event.TimeGenerated, portalTimeZone)}</time></td>
            <td>{event.EventID}</td>
            <td>{event.ActionId ?? 'n/a'}</td>
            <td>{event.Operation}</td>
            <td>{event.LoginName ?? 'n/a'}</td>
            <td>{event.TargetLogin ?? 'n/a'}</td>
            <td>{event.ClientIp ?? 'n/a'}</td>
            <td>{event.Success === true ? 'success' : event.Success === false ? 'failed' : 'unknown'}</td>
            <td>
              <details>
                <summary>{event.Summary ?? String(event.RenderedDescription ?? '').slice(0, 140)}</summary>
                <pre style="white-space: pre-wrap; word-break: break-word;">{event.RenderedDescription}</pre>
              </details>
            </td>
          </tr>
        ))}
      </tbody>
    </table></div>
  )}

  {auditEvents.length > 0 && (
    <details id="audit-event-records">
      <summary><h3>Forwarded Windows event records</h3></summary>
      <p>
        These fields mirror the Windows Event Viewer record collected from the SQL VM's Application
        log before forwarding. The raw description is preserved for independent review.
      </p>
      {auditEvents.map((event) => (
        <details>
          <summary>
            {event.Computer ?? 'Unknown computer'} -- {event.Operation} -- {formatTimestamp(event.TimeGenerated, portalTimeZone)}
          </summary>
          <dl>
            <dt>Log</dt><dd>{event.EventLog ?? 'Application'}</dd>
            <dt>Source</dt><dd>{event.Source ?? 'MSSQLSERVER'}</dd>
            <dt>Level</dt><dd>{event.EventLevelName ?? 'n/a'}</dd>
            <dt>Computer</dt><dd>{event.Computer ?? 'n/a'}</dd>
            <dt>Event ID</dt><dd>{event.EventID}</dd>
            <dt>Time generated ({portalTimeZone})</dt><dd><time datetime={event.TimeGenerated}>{formatTimestamp(event.TimeGenerated, portalTimeZone)}</time></dd>
          </dl>
          <pre style="white-space: pre-wrap; word-break: break-word;">{event.RenderedDescription}</pre>
        </details>
      ))}
    </details>
  )}
  {auditConfigured && !auditError && <RecordPager target="windows-events" total={auditTotal} start={auditStart} windowEnd={auditWindowEnd} server />}
</Layout>

<style>
  .event-refresh { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem; margin-block: 1rem; }
  .event-refresh p { margin: 0; }
  #audit-event-records > summary { padding-block: 0.75rem; }
  #audit-event-records > summary h3 { display: inline; margin: 0; }
  .event-filter { display: flex; flex-wrap: wrap; align-items: end; gap: 0.75rem; margin-block: 1rem; }
  .event-filter-field { display: grid; gap: 0.35rem; min-width: 0; max-width: 100%; }
  .event-filter select { width: 270px; max-width: 100%; min-height: 38px; }
</style>

<script>
  document.querySelectorAll<HTMLFormElement>('.probe-form, .simulation-sample-form, .defender-simulation-form').forEach((form) => {
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const button = form.querySelector<HTMLButtonElement>('button')!;
      const output = form.querySelector<HTMLElement>('.probe-result, .simulation-sample-result')!;
      const fallbackMessage = form.matches('.probe-form') ? 'Exercise failed.' : 'Request failed.';
      button.disabled = true;
      output.textContent = 'Running...';
      try {
        const response = await fetch(form.action, { method: 'POST', body: new FormData(form) });
        if (response.status === 401) throw new Error('Session expired. Sign in again.');
        const result = await response.json();
        if (!response.ok) throw new Error(result.error || fallbackMessage);
        output.textContent = `${result.outcome} Run ID: ${result.runId}`;
      } catch (error) {
        output.textContent = error instanceof Error ? error.message : fallbackMessage;
      } finally { button.disabled = false; }
    });
  });
</script>
