---
import Layout from '../../layouts/Layout.astro';
import { isAuthenticated } from '../../lib/adminAuth.mjs';

if (isAuthenticated(Astro.cookies)) {
  return Astro.redirect('/admin');
}

const errorCode = Astro.url.searchParams.get('error');
const errorMessages = {
  invalid: 'Invalid username or password.',
  ratelimited: 'Too many attempts from this client. Try again in a few minutes.',
  notconfigured: 'The admin portal is not configured on this deployment.',
};
const errorMessage = errorCode ? (errorMessages[errorCode] ?? 'Sign-in failed.') : null;
---
<Layout title="Admin sign-in">
  <div class="banner">
    This account can enable, disable, and rotate the password of the SQL Server <code>sa</code> login.
    Restricted use only &mdash; see the "Admin portal" section of the repository README for why this
    is a deliberately high-risk feature.
  </div>
  {errorMessage && <div class="warn">{errorMessage}</div>}
  <form class="stack" method="post" action="/api/admin/login">
    <label>Username
      <input type="text" name="username" autocomplete="username" required />
    </label>
    <label>Password
      <input type="password" name="password" autocomplete="current-password" required />
    </label>
    <div class="actions">
      <button type="submit">Sign in</button>
    </div>
  </form>
</Layout>
