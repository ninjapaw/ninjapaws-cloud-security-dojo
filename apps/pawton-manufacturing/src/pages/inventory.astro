---
import Layout from '../layouts/Layout.astro';
import { isDatabaseConfigured, query } from '../lib/db.mjs';

let rows: Array<Record<string, unknown>> = [];
let columns: string[] = [];
let error = null;
if (isDatabaseConfigured()) {
  try {
    rows = await query('SELECT TOP 25 * FROM vw_InventoryValuation');
    columns = rows.length ? Object.keys(rows[0]) : [];
  } catch {
    error = 'Inventory data is unavailable. Contact the environment operator.';
  }
} else {
  error = 'Database is not configured on this Web App yet.';
}
---
<Layout title="Inventory">
  <header class="page-header">
    <p class="eyebrow">Supply chain</p>
    <h1>Inventory valuation</h1>
    <p>Review inventory value by warehouse and item type using the <code>vw_InventoryValuation</code> report view.</p>
  </header>
  {error && <div class="warn">{error}</div>}
  {!error && rows.length === 0 && <div class="section"><p>No inventory records are available right now.</p></div>}
  {!error && rows.length > 0 && (
    <section class="section">
      <div class="section-header"><h2>Warehouse and item detail</h2><p>Showing up to 25 records</p></div>
      <div class="table-shell"><table>
        <thead><tr>{columns.map((c) => <th>{c}</th>)}</tr></thead>
        <tbody>{rows.map((row) => <tr>{columns.map((c) => <td>{String(row[c] ?? '')}</td>)}</tr>)}</tbody>
      </table></div>
    </section>
  )}
</Layout>
