---
import Layout from '../layouts/Layout.astro';
import { getUser, isUserLoginConfigured } from '../lib/userAuth.mjs';
import { isAuthenticated, isAdminPortalConfigured } from '../lib/adminAuth.mjs';
if (isAuthenticated(Astro.cookies)) return Astro.redirect('/admin');
if (getUser(Astro.cookies)) return Astro.redirect('/orders');
const configured = isUserLoginConfigured() || isAdminPortalConfigured();
const messages: Record<string, string> = {
  invalid: 'Invalid username or password.',
  ratelimited: 'Too many attempts. Try again in 15 minutes.',
};
const message = messages[Astro.url.searchParams.get('error') ?? ''];
---
<Layout title="Login">
  <header class="page-header"><h1>Login</h1></header>
  {!configured && <div class="warn">Login has not been configured for this environment.</div>}
  {message && <div class="warn" role="alert">{message}</div>}
  <form class="stack" method="post" action="/api/user/login">
    <label>Username<input type="text" name="username" autocomplete="username" maxlength="100" required disabled={!configured} /></label>
    <label>Password<input type="password" name="password" autocomplete="current-password" maxlength="1024" required disabled={!configured} /></label>
    <div class="actions"><button type="submit" disabled={!configured}>Login</button></div>
  </form>
</Layout>