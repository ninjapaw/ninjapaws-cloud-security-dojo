---
import Layout from '../../layouts/Layout.astro';
import OrderForm from '../../components/OrderForm.astro';
import { getUser } from '../../lib/userAuth.mjs';
import { orders, OrderError } from '../../lib/orders.mjs';
const username = getUser(Astro.cookies);
if (!username) return Astro.redirect('/login');
let order = null;
let catalog = null;
let error = '';
try {
  order = await orders.get(Astro.params.id, username);
  if (order.Status === 'Draft') catalog = await orders.lookups();
} catch (failure) {
  Astro.response.status = failure instanceof OrderError ? failure.status : 503;
  error = failure instanceof OrderError ? failure.message : 'Order service is unavailable.';
}
---
<Layout title="Order details">
  <header class="page-header"><p class="eyebrow">Sales operations</p><h1>Order details</h1>{order && <><p>{order.OrderNumber}</p><p><strong>{order.Status}</strong></p></>}</header>
  {error && <div class="warn" role="alert">{error}</div>}
  {order && !error && <>
    {order.Status === 'Draft' && catalog ? <>
      <OrderForm catalog={catalog} order={order} />
      <section class="section"><h2>Saved draft actions</h2><p>Confirmation does not reserve stock or release production. Confirmed orders are read-only here.</p>
        <div class="actions">{['confirm', 'cancel'].map(action => <form method="post" action="/api/orders">
          <input type="hidden" name="orderId" value={order.SalesOrderID} /><input type="hidden" name="revision" value={order.Revision} /><input type="hidden" name="action" value={action} />
          <label class="confirmation"><input type="checkbox" name="confirm" value="yes" required />{action === 'confirm' ? 'Confirm the saved order' : 'Cancel this draft'}</label>
          <button type="submit" class={action === 'cancel' ? 'secondary' : ''}>{action === 'confirm' ? 'Confirm saved order' : 'Cancel draft'}</button>
        </form>)}</div>
      </section>
    </> : <>
      <p>Total: <strong>{Number(order.TotalAmount).toFixed(2)}</strong></p>
      <div class="table-shell" tabindex="0" role="region" aria-label="Order items"><table><thead><tr><th>Product</th><th>Quantity</th><th>Unit price</th><th>Line total</th></tr></thead><tbody>{order.lines.map((line: { ItemName: string; Quantity: number; UnitPrice: number; LineTotal: number }) => <tr><td>{line.ItemName}</td><td>{line.Quantity}</td><td>{Number(line.UnitPrice).toFixed(2)}</td><td>{Number(line.LineTotal).toFixed(2)}</td></tr>)}</tbody></table></div>
      {order.Notes && <p>{order.Notes}</p>}
      <p><a href="/orders">Back to orders</a></p>
    </>}
  </>}
</Layout>