---
import Layout from '../../layouts/Layout.astro';
import OrderForm from '../../components/OrderForm.astro';
import { getUser } from '../../lib/userAuth.mjs';
import { orders } from '../../lib/orders.mjs';
if (!getUser(Astro.cookies)) return Astro.redirect('/login');
let catalog = null;
try { catalog = await orders.lookups(); } catch { }
---
<Layout title="New customer order">
  <header class="page-header"><p class="eyebrow">Sales operations</p><h1>New customer order</h1></header>
  {catalog && catalog.customers.length && catalog.warehouses.length && catalog.items.length ? <OrderForm catalog={catalog} /> : <div class="warn">Order entry requires an available database and active customers, warehouses, and products.</div>}
</Layout>