---
import Layout from '../layouts/Layout.astro';
import RecordPager from '../components/RecordPager.astro';
import { isDatabaseConfigured, query } from '../lib/db.mjs';

let rows: Array<Record<string, unknown>> = [];
let columns: string[] = [];
let error = null;
if (isDatabaseConfigured()) {
  try {
    rows = await query('SELECT * FROM vw_Sales_ByChannel ORDER BY 1');
    columns = rows.length ? Object.keys(rows[0]) : [];
  } catch {
    error = 'Sales data is unavailable. Contact the environment operator.';
  }
} else {
  error = 'Database is not configured on this Web App yet.';
}
---
<Layout title="Sales">
  <header class="page-header">
    <p class="eyebrow">Commercial performance</p>
    <h1>Sales by channel</h1>
    <p>Compare Retail, Online, and Wholesale performance from the <code>vw_Sales_ByChannel</code> report view.</p>
  </header>
  {error && <div class="warn">{error}</div>}
  {!error && rows.length === 0 && <div class="section"><p>No sales records are available right now.</p></div>}
  {!error && rows.length > 0 && (
    <section class="section">
      <div class="section-header"><h2>Channel summary</h2><p>{rows.length} records</p></div>
      <div class="table-shell" id="sales-records" tabindex="0" role="region" aria-label="Sales records"><table>
        <thead><tr>{columns.map((c) => <th>{c}</th>)}</tr></thead>
        <tbody>{rows.map((row, index) => <tr data-record hidden={index >= 25}>{columns.map((c) => <td>{String(row[c] ?? '')}</td>)}</tr>)}</tbody>
      </table></div>
      <RecordPager target="sales-records" total={rows.length} />
    </section>
  )}
</Layout>
