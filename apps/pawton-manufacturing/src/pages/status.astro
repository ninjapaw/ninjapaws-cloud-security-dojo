---
import Layout from '../layouts/Layout.astro';

Astro.response.headers.set('Cache-Control', 'no-store');
let status = null;
let error = null;
try {
  const response = await fetch(new URL('/api/status', Astro.url), { headers: { accept: 'application/json' } });
  if (!response.ok) throw new Error(`Status endpoint returned HTTP ${response.status}.`);
  status = await response.json();
} catch {
  error = 'The live status endpoint could not be read. Try refreshing in a moment.';
}
const connected = status?.db_connectivity === 'connected';
---
<Layout title="System status">
  <header class="page-header">
    <p class="eyebrow">Live environment</p>
    <h1>System status</h1>
    <p>Current application, database, network, and monitoring signals from the deployed Pawton Manufacturing environment.</p>
  </header>

  {error && <div class="danger" role="alert">{error}</div>}
  {status && <>
    <section class="section status-hero">
      <div>
        <p class="eyebrow">{status.site}</p>
        <h2>{connected ? 'Operational' : status.db_connectivity === 'not_configured' ? 'Configuration required' : 'Database unavailable'}</h2>
        <p>Last checked <time datetime={status.generated_at}>{new Date(status.generated_at).toLocaleString()}</time>.</p>
      </div>
      <span class:list={['status-pill', connected ? 'status-pill--ok' : 'status-pill--warn']}>
        {connected ? 'All core checks passing' : 'Needs attention'}
      </span>
    </section>

    <section class="section">
      <div class="section-header"><h2>Core services</h2><p>Live application evidence</p></div>
      <div class="grid">
        <article class="card"><div class="label">Database</div><div class="value">{status.db_connectivity === 'connected' ? 'Connected' : status.db_connectivity.replaceAll('_', ' ')}</div><p>{status.sample_database}</p></article>
        <article class="card"><div class="label">Sample records</div><div class="value">{status.sample_item_count ?? '—'}</div><p>Items available from the live sample database.</p></article>
        <article class="card"><div class="label">Network path</div><div class="value">Private VNet</div><p>{status.network.connection}</p></article>
        <article class="card"><div class="label">Public database endpoint</div><div class="value">{status.network.public_database_endpoint ? 'Enabled' : 'Not used by app'}</div><p>Application traffic uses the private connection path.</p></article>
      </div>
    </section>

    <section class="section">
      <div class="section-header"><h2>Protection configuration</h2><p>Deployment evidence, not a replacement for Defender health verification</p></div>
      <div class="grid">
        <article class="card"><div class="label">App Service protection</div><div class="value">{status.defender_monitoring.app_service_threat_protection_requested ? 'Requested' : 'Not requested'}</div><p>{status.defender_monitoring.note}</p></article>
        <article class="card"><div class="label">Scenario</div><div class="value">Scenario 2</div><p>{status.scenario_id}</p></article>
      </div>
      <p class="warn">This page reports application-side evidence. Confirm Defender for SQL, Defender for Servers, sensor health, recommendations, and alerts in Azure Defender for Cloud.</p>
    </section>
  </>}

  <div class="actions"><a class="pill" href="/status">Refresh status</a><a href="/api/status">View JSON evidence</a></div>
</Layout>