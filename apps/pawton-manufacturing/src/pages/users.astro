---
import Layout from '../layouts/Layout.astro';
import RecordPager from '../components/RecordPager.astro';
import { isAuthenticated, ROTATED_SECRET_COOKIE_NAME } from '../lib/adminAuth.mjs';
import { listSqlLogins, loginRestriction } from '../lib/adminDb.mjs';
import { isAdminSecretsConfigured } from '../lib/adminSecrets.mjs';

Astro.response.headers.set('Cache-Control', 'no-store');
const authenticated = isAuthenticated(Astro.cookies);
let logins: Array<{ principal_id: number; name: string; type_desc: string; is_disabled: boolean; isBuiltInAdmin: boolean; hasServerPrivileges: boolean }> = [];
let unavailable = false;
if (authenticated) {
  try { logins = await listSqlLogins(); } catch { unavailable = true; }
}
const password = authenticated ? Astro.cookies.get(ROTATED_SECRET_COOKIE_NAME)?.value : null;
if (password) Astro.cookies.delete(ROTATED_SECRET_COOKIE_NAME, { path: '/' });
const messages: Record<string, string> = {
  sa_enabled: 'Built-in administrator enabled.', sa_disabled: 'Built-in administrator disabled.',
  sa_rotated: 'Built-in administrator password rotated and synchronized to Key Vault.',
  sa_renamed: 'Built-in administrator renamed and synchronized to Key Vault.',
  login_updated: 'Login change completed.', login_failed: 'Login change failed. Check the restrictions, SQL permissions, and current login state. No success is implied.',
};
const message = messages[Astro.url.searchParams.get('msg') ?? ''];
const failed = Astro.url.searchParams.has('error') || Astro.url.searchParams.get('msg') === 'login_failed';
const vaultConfigured = isAdminSecretsConfigured();
---
<Layout title="Users">
  <header class="page-header">
    <p class="eyebrow">Identity administration</p><h1>Users and SQL logins</h1>
    <p>Server sign-in identities for this SQL instance. Database users and role membership are available in Schema.</p>
  </header>
  {!authenticated ? <div class="warn">Sign in as an administrator to view and manage SQL logins. <a href="/admin/login">Admin sign-in</a></div> : <>
    <div class="banner">Training environment. Login changes take effect immediately. Application, Windows, system, and privileged identities are protected from general actions.</div>
    {message && <div class={failed ? 'danger' : 'ok'} role="status">{message}</div>}
    {Astro.url.searchParams.has('error') && <div class="danger" role="alert">The administrator operation failed. Verify SQL and Key Vault state before retrying; a partial change may have occurred.</div>}
    {password && <div class="warn"><strong>New password, shown once:</strong> <code>{password}</code></div>}
    {unavailable && <div class="warn">SQL login inventory is unavailable. Check the configured admin connection and permissions.</div>}
    <section class="section"><div class="section-header"><h2>Server login inventory</h2><span>{logins.length} identities</span></div>
      <div class="table-shell" id="login-records" tabindex="0" role="region" aria-label="SQL login inventory"><table>
        <thead><tr><th scope="col">Login</th><th scope="col">Type</th><th scope="col">State</th><th scope="col">Management</th></tr></thead>
        <tbody>{logins.map((login, index) => {
          const restriction = loginRestriction(login);
          return <tr data-record hidden={index >= 25}><td>{login.name}{login.isBuiltInAdmin && <span class="built-in-label">Built-in administrator (SID 0x01)</span>}</td><td>{login.type_desc.replaceAll('_', ' ')}</td><td>{login.is_disabled ? 'Disabled' : 'Enabled'}</td><td>
            {login.isBuiltInAdmin ? <div class="built-in-management">
              <div class="built-in-actions">
                <form method="post" action={`/api/admin/sa/${login.is_disabled ? 'enable' : 'disable'}`}>
                  <label class="confirmation"><input type="checkbox" name="confirm" value="yes" required />Confirm state change</label>
                  <button type="submit" class="secondary">{login.is_disabled ? 'Enable login' : 'Disable login'}</button>
                </form>
                <form method="post" action="/api/admin/sa/rotate">
                  <label class="confirmation"><input type="checkbox" name="confirm" value="yes" required disabled={!vaultConfigured} />Confirm password rotation</label>
                  <button type="submit" disabled={!vaultConfigured}>Rotate password</button>
                </form>
                <button type="button" class="secondary" data-rename-toggle aria-expanded="false" aria-controls={`rename-login-${login.principal_id}`} disabled={!vaultConfigured}>Rename login</button>
              </div>
              <form class="rename-form" id={`rename-login-${login.principal_id}`} method="post" action="/api/admin/sa/rename" hidden>
                <label>New login name<input type="text" name="newUsername" pattern="[A-Za-z_][A-Za-z0-9_]{0,127}" maxlength="128" required disabled={!vaultConfigured} /></label>
                <label class="confirmation"><input type="checkbox" name="confirm" value="yes" required disabled={!vaultConfigured} />Confirm rename</label>
                <button type="submit" class="secondary" disabled={!vaultConfigured}>Apply rename</button>
              </form>
              {!vaultConfigured && <p class="warn">Key Vault is not configured. Rename and rotation are unavailable.</p>}
            </div> : restriction ? <span>{restriction}</span> : <div>
            <form class="row-actions" method="post" action="/api/admin/users/action">
              <input type="hidden" name="principalId" value={login.principal_id} />
              <label>Action for {login.name}<select name="action">
                <option value={login.is_disabled ? 'enable' : 'disable'}>{login.is_disabled ? 'Enable' : 'Disable'}</option>
                <option value="rotate">Rotate password</option>
                {process.env.ALLOW_DEMO_BLANK_PASSWORDS === 'true' && /^dojo_demo_[a-z0-9_]+$/i.test(login.name) && <option value="clear">Clear password (isolated demo only)</option>}
              </select></label>
              <label class="confirmation"><input type="checkbox" name="confirm" value="yes" required />Confirm change</label><button type="submit">Apply</button>
            </form>
            <button type="button" class="secondary" data-rename-toggle aria-expanded="false" aria-controls={`rename-login-${login.principal_id}`}>Rename login</button>
            <form class="rename-form" id={`rename-login-${login.principal_id}`} method="post" action="/api/admin/users/action" hidden>
              <input type="hidden" name="principalId" value={login.principal_id} />
              <input type="hidden" name="action" value="rename" />
              <label>New login name<input type="text" name="newUsername" pattern="[A-Za-z_][A-Za-z0-9_]{0,127}" maxlength="128" required /></label>
              <label class="confirmation"><input type="checkbox" name="confirm" value="yes" required />Confirm rename</label>
              <button type="submit" class="secondary">Apply rename</button>
            </form>
            </div>}
          </td></tr>;
        })}</tbody>
      </table></div>
      <RecordPager target="login-records" total={logins.length} />
    </section>
    <section class="section"><h2>Disposable test identity</h2><p><code>dojo_demo_reader</code> has a strong generated password and no application database user. Existing identities are never overwritten.</p>
      <form method="post" action="/api/admin/users/action"><input type="hidden" name="action" value="create-demo" />
        <label class="confirmation"><input type="checkbox" name="confirm" value="yes" required />Create the isolated demo login</label><button type="submit" class="secondary">Create demo login</button>
      </form>
      <p>Blank-password testing is off by default. It requires the server setting <code>ALLOW_DEMO_BLANK_PASSWORDS=true</code>, a <code>dojo_demo_</code> login, no server privileges, and no application database user mappings. Restrict network access before opting in; rotate the password afterward.</p>
    </section>
  </>}
</Layout>

<style>
  .built-in-label { display: block; font-size: 12px; margin-top: 0.35rem; }
  .built-in-actions { display: flex; flex-wrap: wrap; align-items: end; gap: 0.75rem; }
  .built-in-actions form { display: grid; gap: 0.5rem; margin: 0; }
  .rename-form { display: grid; gap: 0.75rem; margin-top: 1rem; max-width: 320px; }
  .rename-form[hidden] { display: none; }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-rename-toggle]').forEach(button => {
    button.addEventListener('click', () => {
      const form = document.getElementById(button.getAttribute('aria-controls')!);
      if (!form) return;
      form.hidden = !form.hidden;
      button.setAttribute('aria-expanded', String(!form.hidden));
      if (!form.hidden) form.querySelector<HTMLInputElement>('input[name="newUsername"]')?.focus();
    });
  });
</script>