{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ninja Paws Cloud Security Dojo configuration",
  "type": "object",
  "required": ["version", "deployment", "image", "runtime", "github"],
  "properties": {
    "version": { "const": 1 },
    "deployment": {
      "type": "object",
      "required": ["resourceGroup", "location", "containerRegistryName", "appServiceName", "appServicePlanName", "keyVaultName"],
      "properties": {
        "resourceGroup": { "type": "string", "minLength": 1 },
        "location": { "type": "string", "minLength": 1 },
        "containerRegistryName": { "type": "string", "pattern": "^[a-z0-9]{5,50}$" },
        "appServiceName": { "type": "string", "minLength": 2 },
        "appServicePlanName": { "type": "string", "minLength": 2 },
        "keyVaultName": { "type": "string", "pattern": "^[a-zA-Z0-9-]{3,24}$" }
      }
    },
    "image": {
      "type": "object",
      "required": ["name", "tag", "ubuntuVersion", "nodeMajorVersion"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "tag": { "type": "string", "minLength": 1 },
        "ubuntuVersion": { "type": "string", "minLength": 1 },
        "nodeMajorVersion": { "type": "integer", "minimum": 18 }
      }
    },
    "runtime": {
      "type": "object",
      "required": ["port", "nginxVersion", "vulnerabilityStatus", "defenderEnabled"],
      "properties": {
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "nginxVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "vulnerabilityStatus": { "enum": ["vulnerable", "remediated"] },
        "defenderEnabled": { "type": "boolean" }
      }
    },
    "github": {
      "type": "object",
      "required": ["environments"],
      "properties": {
        "environments": {
          "type": "object",
          "required": ["main", "default"],
          "properties": {
            "main": { "const": "prod" },
            "default": { "const": "dev" }
          }
        }
      }
    }
  }
}