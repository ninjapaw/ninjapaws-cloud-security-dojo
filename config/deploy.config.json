{
  "configVersion": "1.0.0",
  "project": {
    "name": "Ninja Paws Cloud Security Dojo",
    "author": "Dr Bill Mcilhargey",
    "organization": "Ninja Paw",
    "license": "MIT",
    "copyright": "Copyright (c) 2026 Dr Bill Mcilhargey / Ninja Paw",
    "repository": "https://github.com/ninjapaw/ninjapaws-cloud-security-dojo",
    "support": "https://github.com/ninjapaw/ninjapaws-cloud-security-dojo/issues",
    "disclaimer": "This project provisions an INTENTIONALLY VULNERABLE training environment. Deploy only to an isolated subscription you control. Provided as-is, without warranty of any kind. USE AT YOUR OWN RISK."
  },
  "defaults": {
    "scenario": "defender-cloud-scenario-1",
    "scenarioIds": "defender-cloud-scenario-1",
    "location": "centralus",
    "imageName": "ninjapaws-dojo",
    "baseOsImage": "ubuntu",
    "baseOsVersion": "24.04",
    "nginxVersion": "1.30.3",
    "nodeMajorVersion": "20",
    "vulnerabilityStatus": "vulnerable",
    "port": "3000",
    "defenderEnabled": "true",
    "defender": {
      "scanAfterVerify": "true",
      "managePlans": "true",
      "targetCve": "CVE-2026-42533",
      "plans": {
        "AppServices": "Standard",
        "Containers": "Standard",
        "CloudPosture": "Free"
      }
    }
  },
  "scenarios": {
    "defender-cloud-scenario-1": {
      "name": "Defender for Cloud - Scenario 1: NGINX CVE Detection and Remediation",
      "shortName": "NGINX CVE Detection and Remediation",
      "cve": "CVE-2026-42533",
      "advisoryUrl": "https://my.f5.com/manage/s/article/K000162097",
      "affectedVersion": "1.30.3",
      "fixedVersion": "1.30.4",
      "workloads": "App Service, Azure Container Registry, Defender for App Service, Defender for Containers, Defender CSPM"
    }
  },
  "environments": {
    "dev": {
      "branch": "dev",
      "location": "centralus",
      "resourceGroup": "NP-ninjapaws-dojo-Dev-CentralUS",
      "registryName": "ninjapawsdojodev",
      "appServiceName": "ninjapaws-dojo-app-dev",
      "vulnerabilityStatus": "vulnerable",
      "defenderEnabled": "true"
    },
    "prod": {
      "branch": "main",
      "location": "centralus",
      "resourceGroup": "NP-ninjapaws-dojo-CentralUS",
      "registryName": "ninjapawsdojo",
      "appServiceName": "ninjapaws-dojo-app",
      "vulnerabilityStatus": "vulnerable",
      "defenderEnabled": "true"
    }
  }
}
