{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.46.1.21595",
      "templateHash": "10779236064637072042"
    }
  },
  "parameters": {
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]"
    },
    "containerRegistryName": {
      "type": "string"
    },
    "appServiceName": {
      "type": "string"
    },
    "appServicePlanName": {
      "type": "string",
      "defaultValue": "[format('{0}-plan', parameters('appServiceName'))]"
    },
    "containerRegistrySku": {
      "type": "string",
      "defaultValue": "Basic",
      "allowedValues": [
        "Basic",
        "Standard",
        "Premium"
      ],
      "metadata": {
        "description": "Azure Container Registry SKU. Basic is the cheapest tier and sufficient for this single-image training scenario."
      }
    },
    "appServicePlanSku": {
      "type": "string",
      "defaultValue": "B1",
      "allowedValues": [
        "B1",
        "B2",
        "B3",
        "S1",
        "S2",
        "S3",
        "P0v3",
        "P1v3",
        "P2v3",
        "P3v3"
      ],
      "metadata": {
        "description": "App Service Plan SKU. Linux Web App for Containers requires Basic or higher; Free and Shared tiers do not support custom containers, so B1 is the cheapest viable tier."
      }
    },
    "appServicePlanCapacity": {
      "type": "int",
      "defaultValue": 1,
      "minValue": 1,
      "maxValue": 10,
      "metadata": {
        "description": "App Service Plan instance count."
      }
    },
    "imageName": {
      "type": "string",
      "defaultValue": "ninjapaws-dojo"
    },
    "imageTag": {
      "type": "string",
      "defaultValue": "latest"
    },
    "nginxVersion": {
      "type": "string",
      "defaultValue": "1.30.3"
    },
    "vulnerabilityStatus": {
      "type": "string",
      "defaultValue": "vulnerable"
    },
    "port": {
      "type": "int",
      "defaultValue": 3000
    },
    "defenderEnabled": {
      "type": "bool",
      "defaultValue": false
    },
    "defenderAppServicesTier": {
      "type": "string",
      "defaultValue": "Standard"
    },
    "defenderContainersTier": {
      "type": "string",
      "defaultValue": "Standard"
    },
    "defenderCspmTier": {
      "type": "string",
      "defaultValue": "Standard"
    },
    "defenderArmTier": {
      "type": "string",
      "defaultValue": "Standard"
    },
    "appNameTag": {
      "type": "string",
      "defaultValue": ""
    },
    "defenderServerlessProtection": {
      "type": "bool",
      "defaultValue": true
    },
    "defenderServerlessContainers": {
      "type": "bool",
      "defaultValue": true
    },
    "defenderRegistryAssessment": {
      "type": "bool",
      "defaultValue": true
    },
    "defenderDevOpsConnector": {
      "type": "bool",
      "defaultValue": true
    },
    "githubAdvancedSecurity": {
      "type": "bool",
      "defaultValue": true
    },
    "agentlessCodeScanningExpected": {
      "type": "bool",
      "defaultValue": true
    }
  },
  "resources": [
    {
      "type": "Microsoft.ContainerRegistry/registries",
      "apiVersion": "2023-07-01",
      "name": "[replace(parameters('containerRegistryName'), '-', '')]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "[parameters('containerRegistrySku')]"
      },
      "properties": {
        "adminUserEnabled": false,
        "publicNetworkAccess": "Enabled",
        "networkRuleBypassOptions": "AzureServices"
      }
    },
    {
      "type": "Microsoft.ManagedIdentity/userAssignedIdentities",
      "apiVersion": "2023-01-31",
      "name": "[format('{0}-identity', parameters('appServiceName'))]",
      "location": "[parameters('location')]"
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "scope": "[resourceId('Microsoft.ContainerRegistry/registries', replace(parameters('containerRegistryName'), '-', ''))]",
      "name": "[guid(resourceId('Microsoft.ContainerRegistry/registries', replace(parameters('containerRegistryName'), '-', '')), resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('{0}-identity', parameters('appServiceName'))), 'acrPull')]",
      "properties": {
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', '7f951dda-4ed3-4680-a7ca-43fe172d538d')]",
        "principalId": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('{0}-identity', parameters('appServiceName'))), '2023-01-31').principalId]",
        "principalType": "ServicePrincipal"
      },
      "dependsOn": [
        "[resourceId('Microsoft.ContainerRegistry/registries', replace(parameters('containerRegistryName'), '-', ''))]",
        "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('{0}-identity', parameters('appServiceName')))]"
      ]
    },
    {
      "type": "Microsoft.Web/serverfarms",
      "apiVersion": "2023-01-01",
      "name": "[parameters('appServicePlanName')]",
      "location": "[parameters('location')]",
      "kind": "linux",
      "sku": {
        "name": "[parameters('appServicePlanSku')]",
        "capacity": "[parameters('appServicePlanCapacity')]"
      },
      "properties": {
        "reserved": true
      }
    },
    {
      "type": "Microsoft.Web/sites",
      "apiVersion": "2023-01-01",
      "name": "[parameters('appServiceName')]",
      "location": "[parameters('location')]",
      "identity": {
        "type": "UserAssigned",
        "userAssignedIdentities": {
          "[format('{0}', resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('{0}-identity', parameters('appServiceName'))))]": {}
        }
      },
      "properties": {
        "serverFarmId": "[resourceId('Microsoft.Web/serverfarms', parameters('appServicePlanName'))]",
        "httpsOnly": true,
        "siteConfig": {
          "linuxFxVersion": "[format('DOCKER|{0}/{1}:{2}', reference(resourceId('Microsoft.ContainerRegistry/registries', replace(parameters('containerRegistryName'), '-', '')), '2023-07-01').loginServer, parameters('imageName'), parameters('imageTag'))]",
          "alwaysOn": true,
          "http20Enabled": true,
          "minTlsVersion": "1.2",
          "acrUseManagedIdentityCreds": true,
          "acrUserManagedIdentityID": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('{0}-identity', parameters('appServiceName'))), '2023-01-31').clientId]",
          "appSettings": [
            {
              "name": "DOCKER_REGISTRY_SERVER_URL",
              "value": "[format('https://{0}', reference(resourceId('Microsoft.ContainerRegistry/registries', replace(parameters('containerRegistryName'), '-', '')), '2023-07-01').loginServer)]"
            },
            {
              "name": "WEBSITES_ENABLE_APP_SERVICE_STORAGE",
              "value": "false"
            },
            {
              "name": "WEBSITES_PORT",
              "value": "80"
            },
            {
              "name": "NGINX_VERSION",
              "value": "[parameters('nginxVersion')]"
            },
            {
              "name": "VULNERABILITY_STATUS",
              "value": "[parameters('vulnerabilityStatus')]"
            },
            {
              "name": "PORT",
              "value": "[string(parameters('port'))]"
            },
            {
              "name": "DEFENDER_ENABLED",
              "value": "[string(parameters('defenderEnabled'))]"
            },
            {
              "name": "DEFENDER_APPSERVICES_TIER",
              "value": "[parameters('defenderAppServicesTier')]"
            },
            {
              "name": "DEFENDER_CONTAINERS_TIER",
              "value": "[parameters('defenderContainersTier')]"
            },
            {
              "name": "DEFENDER_CSPM_TIER",
              "value": "[parameters('defenderCspmTier')]"
            },
            {
              "name": "DEFENDER_ARM_TIER",
              "value": "[parameters('defenderArmTier')]"
            },
            {
              "name": "APP_NAME_TAG",
              "value": "[parameters('appNameTag')]"
            },
            {
              "name": "DEFENDER_SERVERLESS_PROTECTION",
              "value": "[string(parameters('defenderServerlessProtection'))]"
            },
            {
              "name": "DEFENDER_SERVERLESS_CONTAINERS",
              "value": "[string(parameters('defenderServerlessContainers'))]"
            },
            {
              "name": "DEFENDER_REGISTRY_ASSESSMENT",
              "value": "[string(parameters('defenderRegistryAssessment'))]"
            },
            {
              "name": "DEFENDER_DEVOPS_CONNECTOR",
              "value": "[string(parameters('defenderDevOpsConnector'))]"
            },
            {
              "name": "GITHUB_ADVANCED_SECURITY",
              "value": "[string(parameters('githubAdvancedSecurity'))]"
            },
            {
              "name": "DEFENDER_AGENTLESS_CODE_SCANNING",
              "value": "[string(parameters('agentlessCodeScanningExpected'))]"
            }
          ]
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Web/serverfarms', parameters('appServicePlanName'))]",
        "[resourceId('Microsoft.ContainerRegistry/registries', replace(parameters('containerRegistryName'), '-', ''))]",
        "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('{0}-identity', parameters('appServiceName')))]"
      ]
    },
    {
      "type": "Microsoft.Web/sites/config",
      "apiVersion": "2023-01-01",
      "name": "[format('{0}/{1}', parameters('appServiceName'), 'web')]",
      "properties": {
        "healthCheckPath": "/health"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Web/sites', parameters('appServiceName'))]"
      ]
    }
  ],
  "outputs": {
    "containerRegistryLoginServer": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.ContainerRegistry/registries', replace(parameters('containerRegistryName'), '-', '')), '2023-07-01').loginServer]"
    },
    "containerRegistryId": {
      "type": "string",
      "value": "[resourceId('Microsoft.ContainerRegistry/registries', replace(parameters('containerRegistryName'), '-', ''))]"
    },
    "appServiceUrl": {
      "type": "string",
      "value": "[format('https://{0}', reference(resourceId('Microsoft.Web/sites', parameters('appServiceName')), '2023-01-01').defaultHostName)]"
    },
    "appServiceName": {
      "type": "string",
      "value": "[parameters('appServiceName')]"
    },
    "managedIdentityId": {
      "type": "string",
      "value": "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('{0}-identity', parameters('appServiceName')))]"
    },
    "managedIdentityClientId": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('{0}-identity', parameters('appServiceName'))), '2023-01-31').clientId]"
    },
    "image": {
      "type": "string",
      "value": "[format('{0}/{1}:{2}', reference(resourceId('Microsoft.ContainerRegistry/registries', replace(parameters('containerRegistryName'), '-', '')), '2023-07-01').loginServer, parameters('imageName'), parameters('imageTag'))]"
    }
  }
}