{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.46.1.21595",
      "templateHash": "6076306885814436320"
    }
  },
  "parameters": {
    "webAppName": {
      "type": "string",
      "metadata": {
        "description": "Existing Pawton Linux Web App name."
      }
    },
    "location": {
      "type": "string",
      "metadata": {
        "description": "Region of the existing Web App and its App Service plan."
      }
    },
    "customDomain": {
      "type": "string",
      "minLength": 4,
      "maxLength": 64,
      "metadata": {
        "description": "Verified custom subdomain. Public CNAME must point directly to the Web App default hostname."
      }
    },
    "enableTls": {
      "type": "bool",
      "defaultValue": true,
      "metadata": {
        "description": "Deploy false only for a hostname that has no existing binding; deploy true after the hostname exists to issue and bind HTTPS."
      }
    },
    "certificateName": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Existing managed certificate name when adopting a certificate already issued for this hostname; otherwise a deterministic name is used."
      }
    }
  },
  "resources": [
    {
      "condition": "[parameters('enableTls')]",
      "type": "Microsoft.Web/certificates",
      "apiVersion": "2025-03-01",
      "name": "[if(empty(parameters('certificateName')), format('pawton-{0}', uniqueString(resourceId('Microsoft.Web/sites', parameters('webAppName')), parameters('customDomain'))), parameters('certificateName'))]",
      "location": "[parameters('location')]",
      "properties": {
        "canonicalName": "[parameters('customDomain')]",
        "serverFarmId": "[reference(resourceId('Microsoft.Web/sites', parameters('webAppName')), '2025-03-01').serverFarmId]"
      }
    },
    {
      "type": "Microsoft.Web/sites/hostNameBindings",
      "apiVersion": "2025-03-01",
      "name": "[format('{0}/{1}', parameters('webAppName'), parameters('customDomain'))]",
      "properties": {
        "siteName": "[parameters('webAppName')]",
        "hostNameType": "Verified",
        "customHostNameDnsRecordType": "CName",
        "sslState": "[if(parameters('enableTls'), 'SniEnabled', 'Disabled')]",
        "thumbprint": "[if(parameters('enableTls'), reference(resourceId('Microsoft.Web/certificates', if(empty(parameters('certificateName')), format('pawton-{0}', uniqueString(resourceId('Microsoft.Web/sites', parameters('webAppName')), parameters('customDomain'))), parameters('certificateName'))), '2025-03-01').thumbprint, null())]"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Web/certificates', if(empty(parameters('certificateName')), format('pawton-{0}', uniqueString(resourceId('Microsoft.Web/sites', parameters('webAppName')), parameters('customDomain'))), parameters('certificateName')))]"
      ]
    }
  ],
  "outputs": {
    "portalUrl": {
      "type": "string",
      "value": "[format('https://{0}', parameters('customDomain'))]"
    },
    "certificateName": {
      "type": "string",
      "value": "[if(parameters('enableTls'), if(empty(parameters('certificateName')), format('pawton-{0}', uniqueString(resourceId('Microsoft.Web/sites', parameters('webAppName')), parameters('customDomain'))), parameters('certificateName')), '')]"
    }
  }
}