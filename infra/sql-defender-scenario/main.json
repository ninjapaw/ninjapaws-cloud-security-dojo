{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.47.16.16243",
      "templateHash": "8521773654695630786"
    }
  },
  "parameters": {
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Azure region for all resources in this scenario."
      }
    },
    "vmName": {
      "type": "string",
      "defaultValue": "ninjapaws-sql-vm",
      "metadata": {
        "description": "Base name used to derive the VM, NIC, disk, and related resource names."
      }
    },
    "adminUsername": {
      "type": "string",
      "metadata": {
        "description": "Windows administrator login for the SQL Server VM. Must not be a literal default; supply at deploy time."
      }
    },
    "adminPassword": {
      "type": "securestring",
      "metadata": {
        "description": "Windows administrator password for the SQL Server VM. No default; the deploy script generates a random value per run."
      }
    },
    "vmSize": {
      "type": "string",
      "defaultValue": "Standard_D4s_v4",
      "allowedValues": [
        "Standard_D2s_v4",
        "Standard_D4s_v4",
        "Standard_D4ds_v4"
      ],
      "metadata": {
        "description": "VM size. D-series with local/temp SSD supports SQL Server tempdb placement best practices. v4 sizes are used because the v5 generation has no capacity in this subscription/region."
      }
    },
    "sqlImageSku": {
      "type": "string",
      "defaultValue": "sqldev-gen2",
      "allowedValues": [
        "sqldev-gen2",
        "standard-gen2",
        "enterprise-gen2"
      ],
      "metadata": {
        "description": "SQL Server 2022 on Windows Server 2022 marketplace image SKU. Must be a -gen2 SKU: Trusted Launch (below) requires a generation 2 image, and the publisher no longer offers generation 1 SKUs for this offer. sqldev-gen2 is free for training/dev use."
      }
    },
    "centralWorkspaceResourceGroup": {
      "type": "string",
      "defaultValue": "NP-Sentinel-CentralUS",
      "metadata": {
        "description": "Resource group holding the standardized, subscription-wide Log Analytics workspace all scenarios in this repo forward Defender/SQL telemetry to. Must already exist -- the deploy script provisions it before this template runs."
      }
    },
    "centralWorkspaceName": {
      "type": "string",
      "defaultValue": "log-np-sentinel-centralus",
      "metadata": {
        "description": "Name of the standardized Log Analytics workspace inside centralWorkspaceResourceGroup."
      }
    },
    "bootstrapScriptUrl": {
      "type": "string",
      "metadata": {
        "description": "Raw content base URL used to fetch the futon-manufacturing bootstrap script onto the VM."
      }
    },
    "deployBastion": {
      "type": "bool",
      "defaultValue": true,
      "metadata": {
        "description": "Enable Azure Bastion for browser-based RDP in addition to the configured VM network access."
      }
    },
    "allowAnyBastionSourceIp": {
      "type": "bool",
      "defaultValue": true,
      "metadata": {
        "description": "Allow Just-in-Time RDP access requests from any source IP instead of only the Bastion subnet. Defaults to Any; set false to restrict JIT RDP requests to the Bastion subnet CIDR."
      }
    },
    "autoAllowBastionRdp": {
      "type": "bool",
      "defaultValue": true,
      "metadata": {
        "description": "Add a standing NSG rule allowing RDP from the Bastion subnet so Bastion connections work immediately, without an operator first approving a Defender for Cloud Just-in-Time access request. The JIT policy and its NSG deny rule remain in place for the Defender for Servers demonstration; this allow rule simply takes precedence over it. Set false to require JIT approval before every RDP session."
      }
    },
    "allowPublicSqlAccess": {
      "type": "bool",
      "defaultValue": false,
      "metadata": {
        "description": "Expose SQL Server on a public IP and allow inbound TCP 1433 from public networks. Keep disabled unless this isolated training environment needs public SQL access."
      }
    },
    "allowPublicKeyVaultAccess": {
      "type": "bool",
      "defaultValue": true,
      "metadata": {
        "description": "Allow the Key Vault public endpoint to be reached from the internet. The vault still requires RBAC authorization; set false to require private endpoint access."
      }
    },
    "deployWebApp": {
      "type": "bool",
      "defaultValue": true,
      "metadata": {
        "description": "Deploy the Pawton Manufacturing dashboard: a Node.js/Astro Web App that reads the restored sample data over a private VNet connection."
      }
    },
    "webAppName": {
      "type": "string",
      "defaultValue": "[format('{0}-web', parameters('vmName'))]",
      "metadata": {
        "description": "Name of the Linux Web App hosting the Pawton Manufacturing dashboard."
      }
    },
    "webAppPlanSku": {
      "type": "string",
      "defaultValue": "B1",
      "metadata": {
        "description": "App Service plan SKU for the dashboard Web App."
      }
    },
    "sqlAppLoginPassword": {
      "type": "securestring",
      "metadata": {
        "description": "Password for the least-privilege futon_app SQL login, shared between the Key Vault secret the Web App reads and the VM bootstrap script that creates the login. No default; the deploy script generates a random value per run."
      }
    },
    "adminPortalUsername": {
      "type": "string",
      "defaultValue": "dojo-admin",
      "metadata": {
        "description": "Username the Pawton Manufacturing admin portal (/admin) accepts to authenticate an operator before allowing sa login management. No default; the deploy script generates/reads this per run."
      }
    },
    "adminPortalPassword": {
      "type": "securestring",
      "metadata": {
        "description": "Password the admin portal (/admin) accepts alongside adminPortalUsername. Stored only in Key Vault and as a Web App setting -- never checked into source. No default; the deploy script generates a random value per run."
      }
    },
    "adminSessionSecret": {
      "type": "securestring",
      "metadata": {
        "description": "HMAC signing key for the admin portal session cookie. No default; the deploy script generates a random value per run."
      }
    },
    "sqlAdminOpsPassword": {
      "type": "securestring",
      "metadata": {
        "description": "Password for the dojo_admin_portal_svc SQL login the admin portal uses to enable/disable/rotate the sa login. This login is granted CONTROL SERVER (the only permission SQL Server accepts for altering sa) -- functionally equivalent to sysadmin. Handing a public-facing Web App this credential is itself the anti-pattern this scenario demonstrates; see README.md. No default; the deploy script generates a random value per run."
      }
    },
    "sqlSaLoginPassword": {
      "type": "securestring",
      "metadata": {
        "description": "Initial password for the SQL Server built-in administrator login. The deploy script generates it, the VM bootstrap applies it, and Key Vault retains the authoritative current value after portal rotations."
      }
    },
    "sqlSaLoginUsername": {
      "type": "string",
      "defaultValue": "sa",
      "metadata": {
        "description": "Current name of SQL Server built-in administrator login. The deploy script preserves the existing Key Vault value on redeploy so a portal rename is not reverted."
      }
    }
  },
  "variables": {
    "nsgName": "[format('{0}-nsg', parameters('vmName'))]",
    "vnetName": "[format('{0}-vnet', parameters('vmName'))]",
    "nicName": "[format('{0}-nic', parameters('vmName'))]",
    "vmSubnetPrefix": "10.20.1.0/24",
    "bastionSubnetPrefix": "10.20.2.0/26",
    "webAppSubnetPrefix": "10.20.3.0/24",
    "privateEndpointSubnetPrefix": "10.20.4.0/27",
    "sqlVmResourceName": "[parameters('vmName')]",
    "computerName": "[take(replace(parameters('vmName'), '-', ''), 15)]",
    "keyVaultResourceName": "[take(toLower(replace(format('{0}kv', parameters('vmName')), '-', '')), 24)]"
  },
  "resources": [
    {
      "type": "Microsoft.Network/networkSecurityGroups",
      "apiVersion": "2025-01-01",
      "name": "[variables('nsgName')]",
      "location": "[parameters('location')]",
      "properties": {
        "securityRules": "[concat(if(parameters('allowPublicSqlAccess'), createArray(createObject('name', 'AllowPublicSql', 'properties', createObject('priority', 100, 'direction', 'Inbound', 'access', 'Allow', 'protocol', 'Tcp', 'sourcePortRange', '*', 'destinationPortRange', '1433', 'sourceAddressPrefix', '*', 'destinationAddressPrefix', variables('vmSubnetPrefix')))), createArray()), if(parameters('deployWebApp'), createArray(createObject('name', 'AllowWebAppToSql', 'properties', createObject('priority', 110, 'direction', 'Inbound', 'access', 'Allow', 'protocol', 'Tcp', 'sourcePortRange', '*', 'destinationPortRange', '1433', 'sourceAddressPrefix', variables('webAppSubnetPrefix'), 'destinationAddressPrefix', variables('vmSubnetPrefix')))), createArray()), if(and(parameters('deployBastion'), parameters('autoAllowBastionRdp')), createArray(createObject('name', 'AllowBastionRdp', 'properties', createObject('priority', 120, 'direction', 'Inbound', 'access', 'Allow', 'protocol', 'Tcp', 'sourcePortRange', '*', 'destinationPortRange', '3389', 'sourceAddressPrefix', variables('bastionSubnetPrefix'), 'destinationAddressPrefix', variables('vmSubnetPrefix')))), createArray()))]"
      }
    },
    {
      "type": "Microsoft.Network/virtualNetworks",
      "apiVersion": "2025-01-01",
      "name": "[variables('vnetName')]",
      "location": "[parameters('location')]",
      "properties": {
        "addressSpace": {
          "addressPrefixes": [
            "10.20.0.0/16"
          ]
        },
        "subnets": "[concat(createArray(createObject('name', 'sql-vm-subnet', 'properties', createObject('addressPrefix', variables('vmSubnetPrefix'), 'networkSecurityGroup', createObject('id', resourceId('Microsoft.Network/networkSecurityGroups', variables('nsgName')))))), if(parameters('deployBastion'), createArray(createObject('name', 'AzureBastionSubnet', 'properties', createObject('addressPrefix', variables('bastionSubnetPrefix')))), createArray()), if(parameters('deployWebApp'), createArray(createObject('name', 'webapp-integration-subnet', 'properties', createObject('addressPrefix', variables('webAppSubnetPrefix'), 'delegations', createArray(createObject('name', 'webapp-delegation', 'properties', createObject('serviceName', 'Microsoft.Web/serverFarms'))))), createObject('name', 'private-endpoint-subnet', 'properties', createObject('addressPrefix', variables('privateEndpointSubnetPrefix'), 'privateEndpointNetworkPolicies', 'Disabled'))), createArray()))]"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Network/networkSecurityGroups', variables('nsgName'))]"
      ]
    },
    {
      "condition": "[parameters('deployWebApp')]",
      "type": "Microsoft.Network/privateDnsZones",
      "apiVersion": "2024-06-01",
      "name": "privatelink.vaultcore.azure.net",
      "location": "global"
    },
    {
      "condition": "[parameters('deployWebApp')]",
      "type": "Microsoft.Network/privateDnsZones/virtualNetworkLinks",
      "apiVersion": "2024-06-01",
      "name": "[format('{0}/{1}', 'privatelink.vaultcore.azure.net', format('{0}-link', variables('vnetName')))]",
      "location": "global",
      "properties": {
        "virtualNetwork": {
          "id": "[resourceId('Microsoft.Network/virtualNetworks', variables('vnetName'))]"
        },
        "registrationEnabled": false
      },
      "dependsOn": [
        "[resourceId('Microsoft.Network/privateDnsZones', 'privatelink.vaultcore.azure.net')]",
        "[resourceId('Microsoft.Network/virtualNetworks', variables('vnetName'))]"
      ]
    },
    {
      "condition": "[parameters('deployWebApp')]",
      "type": "Microsoft.Network/privateEndpoints",
      "apiVersion": "2025-01-01",
      "name": "[format('{0}-pe', variables('keyVaultResourceName'))]",
      "location": "[parameters('location')]",
      "properties": {
        "subnet": {
          "id": "[resourceId('Microsoft.Network/virtualNetworks/subnets', variables('vnetName'), 'private-endpoint-subnet')]"
        },
        "privateLinkServiceConnections": [
          {
            "name": "[format('{0}-plsc', variables('keyVaultResourceName'))]",
            "properties": {
              "privateLinkServiceId": "[resourceId('Microsoft.KeyVault/vaults', variables('keyVaultResourceName'))]",
              "groupIds": [
                "vault"
              ]
            }
          }
        ]
      },
      "dependsOn": [
        "[resourceId('Microsoft.KeyVault/vaults', variables('keyVaultResourceName'))]",
        "[resourceId('Microsoft.Network/virtualNetworks', variables('vnetName'))]"
      ]
    },
    {
      "condition": "[parameters('deployWebApp')]",
      "type": "Microsoft.Network/privateEndpoints/privateDnsZoneGroups",
      "apiVersion": "2025-01-01",
      "name": "[format('{0}/{1}', format('{0}-pe', variables('keyVaultResourceName')), 'default')]",
      "properties": {
        "privateDnsZoneConfigs": [
          {
            "name": "privatelink-vaultcore-azure-net",
            "properties": {
              "privateDnsZoneId": "[resourceId('Microsoft.Network/privateDnsZones', 'privatelink.vaultcore.azure.net')]"
            }
          }
        ]
      },
      "dependsOn": [
        "[resourceId('Microsoft.Network/privateDnsZones', 'privatelink.vaultcore.azure.net')]",
        "[resourceId('Microsoft.Network/privateEndpoints', format('{0}-pe', variables('keyVaultResourceName')))]"
      ]
    },
    {
      "condition": "[parameters('deployBastion')]",
      "type": "Microsoft.Network/publicIPAddresses",
      "apiVersion": "2025-01-01",
      "name": "[format('{0}-bastion-pip', parameters('vmName'))]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "Standard"
      },
      "properties": {
        "publicIPAllocationMethod": "Static"
      }
    },
    {
      "condition": "[parameters('allowPublicSqlAccess')]",
      "type": "Microsoft.Network/publicIPAddresses",
      "apiVersion": "2025-01-01",
      "name": "[format('{0}-sql-pip', parameters('vmName'))]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "Standard"
      },
      "properties": {
        "publicIPAllocationMethod": "Static"
      }
    },
    {
      "condition": "[parameters('deployBastion')]",
      "type": "Microsoft.Network/bastionHosts",
      "apiVersion": "2025-01-01",
      "name": "[format('{0}-bastion', parameters('vmName'))]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "Basic"
      },
      "properties": {
        "ipConfigurations": [
          {
            "name": "bastion-ipconfig",
            "properties": {
              "subnet": {
                "id": "[reference(resourceId('Microsoft.Network/virtualNetworks', variables('vnetName')), '2025-01-01').subnets[1].id]"
              },
              "publicIPAddress": {
                "id": "[resourceId('Microsoft.Network/publicIPAddresses', format('{0}-bastion-pip', parameters('vmName')))]"
              }
            }
          }
        ]
      },
      "dependsOn": [
        "[resourceId('Microsoft.Network/publicIPAddresses', format('{0}-bastion-pip', parameters('vmName')))]",
        "[resourceId('Microsoft.Network/virtualNetworks', variables('vnetName'))]"
      ]
    },
    {
      "condition": "[parameters('deployBastion')]",
      "type": "Microsoft.Security/locations/jitNetworkAccessPolicies",
      "apiVersion": "2020-01-01",
      "name": "[format('{0}/default', parameters('location'))]",
      "kind": "Basic",
      "properties": {
        "virtualMachines": [
          {
            "id": "[resourceId('Microsoft.Compute/virtualMachines', parameters('vmName'))]",
            "ports": [
              {
                "number": 3389,
                "protocol": "*",
                "allowedSourceAddressPrefix": "[if(parameters('allowAnyBastionSourceIp'), '*', variables('bastionSubnetPrefix'))]",
                "maxRequestAccessDuration": "PT3H"
              }
            ]
          }
        ]
      },
      "dependsOn": [
        "[resourceId('Microsoft.Compute/virtualMachines', parameters('vmName'))]"
      ]
    },
    {
      "type": "Microsoft.Network/networkInterfaces",
      "apiVersion": "2025-01-01",
      "name": "[variables('nicName')]",
      "location": "[parameters('location')]",
      "properties": {
        "ipConfigurations": [
          {
            "name": "ipconfig1",
            "properties": {
              "privateIPAllocationMethod": "Dynamic",
              "subnet": {
                "id": "[reference(resourceId('Microsoft.Network/virtualNetworks', variables('vnetName')), '2025-01-01').subnets[0].id]"
              },
              "publicIPAddress": "[if(parameters('allowPublicSqlAccess'), createObject('id', resourceId('Microsoft.Network/publicIPAddresses', format('{0}-sql-pip', parameters('vmName')))), null())]"
            }
          }
        ]
      },
      "dependsOn": [
        "[resourceId('Microsoft.Network/publicIPAddresses', format('{0}-sql-pip', parameters('vmName')))]",
        "[resourceId('Microsoft.Network/virtualNetworks', variables('vnetName'))]"
      ]
    },
    {
      "type": "Microsoft.Compute/virtualMachines",
      "apiVersion": "2024-11-01",
      "name": "[parameters('vmName')]",
      "location": "[parameters('location')]",
      "identity": {
        "type": "SystemAssigned"
      },
      "properties": {
        "hardwareProfile": {
          "vmSize": "[parameters('vmSize')]"
        },
        "osProfile": {
          "computerName": "[variables('computerName')]",
          "adminUsername": "[parameters('adminUsername')]",
          "adminPassword": "[parameters('adminPassword')]",
          "windowsConfiguration": {
            "enableAutomaticUpdates": true,
            "patchSettings": {
              "patchMode": "AutomaticByOS"
            }
          }
        },
        "storageProfile": {
          "imageReference": {
            "publisher": "MicrosoftSQLServer",
            "offer": "sql2022-ws2022",
            "sku": "[parameters('sqlImageSku')]",
            "version": "latest"
          },
          "osDisk": {
            "createOption": "FromImage",
            "managedDisk": {
              "storageAccountType": "Premium_LRS"
            }
          }
        },
        "securityProfile": {
          "securityType": "TrustedLaunch",
          "uefiSettings": {
            "secureBootEnabled": true,
            "vTpmEnabled": true
          }
        },
        "networkProfile": {
          "networkInterfaces": [
            {
              "id": "[resourceId('Microsoft.Network/networkInterfaces', variables('nicName'))]"
            }
          ]
        },
        "diagnosticsProfile": {
          "bootDiagnostics": {
            "enabled": true
          }
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Network/networkInterfaces', variables('nicName'))]"
      ]
    },
    {
      "type": "Microsoft.SqlVirtualMachine/sqlVirtualMachines",
      "apiVersion": "2023-10-01",
      "name": "[variables('sqlVmResourceName')]",
      "location": "[parameters('location')]",
      "properties": {
        "virtualMachineResourceId": "[resourceId('Microsoft.Compute/virtualMachines', parameters('vmName'))]",
        "sqlManagement": "Full",
        "sqlServerLicenseType": "PAYG",
        "leastPrivilegeMode": "Enabled",
        "autoPatchingSettings": {
          "enable": true,
          "dayOfWeek": "Sunday",
          "maintenanceWindowStartingHour": 2,
          "maintenanceWindowDuration": 60
        },
        "autoBackupSettings": {
          "enable": false
        },
        "serverConfigurationsManagementSettings": {
          "sqlConnectivityUpdateSettings": {
            "connectivityType": "PRIVATE",
            "port": 1433
          },
          "sqlWorkloadTypeUpdateSettings": {
            "sqlWorkloadType": "OLTP"
          },
          "additionalFeaturesServerConfigurations": {
            "isRServicesEnabled": false
          }
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Compute/virtualMachines', parameters('vmName'))]"
      ]
    },
    {
      "type": "Microsoft.Compute/virtualMachines/extensions",
      "apiVersion": "2024-11-01",
      "name": "[format('{0}/{1}', parameters('vmName'), 'futon-manufacturing-bootstrap')]",
      "location": "[parameters('location')]",
      "properties": {
        "publisher": "Microsoft.Compute",
        "type": "CustomScriptExtension",
        "typeHandlerVersion": "1.10",
        "autoUpgradeMinorVersion": true,
        "settings": {
          "fileUris": [
            "[parameters('bootstrapScriptUrl')]"
          ]
        },
        "protectedSettings": {
          "commandToExecute": "[format('powershell -ExecutionPolicy Unrestricted -File Setup-FutonManufacturing.ps1 -AppLoginPasswordBase64 {0} -AdminOpsLoginPasswordBase64 {1} -SaLoginPasswordBase64 {2}', base64(parameters('sqlAppLoginPassword')), base64(parameters('sqlAdminOpsPassword')), base64(parameters('sqlSaLoginPassword')))]"
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.SqlVirtualMachine/sqlVirtualMachines', variables('sqlVmResourceName'))]",
        "[resourceId('Microsoft.Compute/virtualMachines', parameters('vmName'))]"
      ]
    },
    {
      "type": "Microsoft.Compute/virtualMachines/extensions",
      "apiVersion": "2024-11-01",
      "name": "[format('{0}/{1}', parameters('vmName'), 'AzureMonitorWindowsAgent')]",
      "location": "[parameters('location')]",
      "properties": {
        "publisher": "Microsoft.Azure.Monitor",
        "type": "AzureMonitorWindowsAgent",
        "typeHandlerVersion": "1.24",
        "autoUpgradeMinorVersion": true,
        "enableAutomaticUpgrade": true
      },
      "dependsOn": [
        "[resourceId('Microsoft.Compute/virtualMachines/extensions', parameters('vmName'), 'futon-manufacturing-bootstrap')]",
        "[resourceId('Microsoft.Compute/virtualMachines', parameters('vmName'))]"
      ]
    },
    {
      "type": "Microsoft.Insights/dataCollectionRules",
      "apiVersion": "2024-03-11",
      "name": "[format('{0}-dcr', parameters('vmName'))]",
      "location": "[parameters('location')]",
      "properties": {
        "dataSources": {
          "windowsEventLogs": [
            {
              "name": "securityEvents",
              "streams": [
                "Microsoft-Event"
              ],
              "xPathQueries": [
                "Security!*",
                "System!*",
                "Application!*"
              ]
            }
          ]
        },
        "destinations": {
          "logAnalytics": [
            {
              "name": "centralWorkspace",
              "workspaceResourceId": "[extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, parameters('centralWorkspaceResourceGroup')), 'Microsoft.OperationalInsights/workspaces', parameters('centralWorkspaceName'))]"
            }
          ]
        },
        "dataFlows": [
          {
            "streams": [
              "Microsoft-Event"
            ],
            "destinations": [
              "centralWorkspace"
            ]
          }
        ]
      }
    },
    {
      "type": "Microsoft.Insights/dataCollectionRuleAssociations",
      "apiVersion": "2024-03-11",
      "scope": "[resourceId('Microsoft.Compute/virtualMachines', parameters('vmName'))]",
      "name": "[format('{0}-dcra', parameters('vmName'))]",
      "properties": {
        "dataCollectionRuleId": "[resourceId('Microsoft.Insights/dataCollectionRules', format('{0}-dcr', parameters('vmName')))]"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Compute/virtualMachines/extensions', parameters('vmName'), 'AzureMonitorWindowsAgent')]",
        "[resourceId('Microsoft.Insights/dataCollectionRules', format('{0}-dcr', parameters('vmName')))]",
        "[resourceId('Microsoft.Compute/virtualMachines', parameters('vmName'))]"
      ]
    },
    {
      "type": "Microsoft.KeyVault/vaults",
      "apiVersion": "2024-11-01",
      "name": "[variables('keyVaultResourceName')]",
      "location": "[parameters('location')]",
      "tags": "[if(parameters('allowPublicKeyVaultAccess'), createObject('SecurityControl', 'Ignore'), createObject())]",
      "properties": {
        "sku": {
          "family": "A",
          "name": "standard"
        },
        "tenantId": "[subscription().tenantId]",
        "enableRbacAuthorization": true,
        "enableSoftDelete": true,
        "enablePurgeProtection": true,
        "publicNetworkAccess": "[if(parameters('allowPublicKeyVaultAccess'), 'Enabled', 'Disabled')]"
      }
    },
    {
      "type": "Microsoft.KeyVault/vaults/secrets",
      "apiVersion": "2024-11-01",
      "name": "[format('{0}/{1}', variables('keyVaultResourceName'), 'sql-app-login-password')]",
      "properties": {
        "value": "[parameters('sqlAppLoginPassword')]"
      },
      "dependsOn": [
        "[resourceId('Microsoft.KeyVault/vaults', variables('keyVaultResourceName'))]"
      ]
    },
    {
      "type": "Microsoft.KeyVault/vaults/secrets",
      "apiVersion": "2024-11-01",
      "name": "[format('{0}/{1}', variables('keyVaultResourceName'), 'vm-admin-username')]",
      "properties": {
        "value": "[parameters('adminUsername')]"
      },
      "dependsOn": [
        "[resourceId('Microsoft.KeyVault/vaults', variables('keyVaultResourceName'))]"
      ]
    },
    {
      "type": "Microsoft.KeyVault/vaults/secrets",
      "apiVersion": "2024-11-01",
      "name": "[format('{0}/{1}', variables('keyVaultResourceName'), 'vm-admin-password')]",
      "properties": {
        "value": "[parameters('adminPassword')]"
      },
      "dependsOn": [
        "[resourceId('Microsoft.KeyVault/vaults', variables('keyVaultResourceName'))]"
      ]
    },
    {
      "type": "Microsoft.KeyVault/vaults/secrets",
      "apiVersion": "2024-11-01",
      "name": "[format('{0}/{1}', variables('keyVaultResourceName'), 'admin-portal-username')]",
      "properties": {
        "value": "[parameters('adminPortalUsername')]"
      },
      "dependsOn": [
        "[resourceId('Microsoft.KeyVault/vaults', variables('keyVaultResourceName'))]"
      ]
